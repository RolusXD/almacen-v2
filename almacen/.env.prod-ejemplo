# ============================================
# Sistema de Almacen TOI - Produccion Ubuntu
# Archivo de ejemplo
# ============================================
#
# Este proyecto usa variables de entorno del sistema/Apache.
# Puedes usar este archivo como plantilla de referencia.
# Si deseas cargarlo manualmente, deberas hacerlo desde Apache,
# systemd, Docker o tu metodo de despliegue.

# --------------------------------------------
# Aplicacion
# --------------------------------------------
APP_NAME=Sistema de Almacen TOI
APP_ENV=production
APP_URL=http://TU_DOMINIO_O_IP

# --------------------------------------------
# Base de datos PostgreSQL
# --------------------------------------------
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=almacen_toi
DB_USER=almacen_user
DB_PASS=CAMBIAR_PASSWORD_SEGURA
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Solo usar si tu proveedor PostgreSQL lo requiere
# Ejemplo Neon: DB_PG_OPTIONS=endpoint=ep-xxxxxxx
DB_PG_OPTIONS=

# --------------------------------------------
# Sesiones
# --------------------------------------------
# Recomendado en produccion:
SESSION_DRIVER=database

# --------------------------------------------
# Alternativa usando URL completa de PostgreSQL
# --------------------------------------------
# Si defines DATABASE_URL, el proyecto puede tomar host, base,
# usuario, password, puerto y algunos parametros automaticamente.
#
# DATABASE_URL=postgresql://almacen_user:CAMBIAR_PASSWORD_SEGURA@localhost:5432/almacen_toi?sslmode=prefer

# --------------------------------------------
# Variables compatibles adicionales
# --------------------------------------------
# El proyecto tambien reconoce estas si existen:
#
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=almacen_toi
# PGUSER=almacen_user
# PGPASSWORD=CAMBIAR_PASSWORD_SEGURA
# PGOPTIONS=

# --------------------------------------------
# Notas
# --------------------------------------------
# 1. No dejar APP_ENV=development en produccion.
# 2. Si SESSION_DRIVER no es "database", el sistema usara:
#    storage/sessions
# 3. Si usas Apache con VirtualHost, puedes mapear estas
#    variables con SetEnv.
