# ==========================================================
# VARIABLES DE ENTORNO: Sistema de Almacén TOI v4.0
# Copie este archivo a .env y configure sus valores
# ==========================================================

NODE_ENV=production
PORT=3000

# URL pública donde responderá Coolify (con HTTPS si tiene certificado)
APP_URL=https://almacen.toi.bo

# Llave de firma para las sesiones de usuario (Genere una clave segura y aleatoria)
SESSION_SECRET=toi_super_secure_random_production_key_2026_xyz987

# Clave de cifrado AES-256-GCM para contraseñas SMTP (32 bytes en hex = 64 caracteres hex)
ENCRYPTION_KEY=c2ae56f3696a3b475846e5698302d2895d03b53f39935d1a05353a4def177a85

# Configuración de Base de Datos PostgreSQL
# Opción A: Mediante DATABASE_URL completa
DATABASE_URL=postgresql://almacen_toi:almacen_secure_password_2026@localhost:5432/almacen_toi

# Opción B: Variables desglosadas (si no usa DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=almacen_toi
DB_USER=almacen_toi
DB_PASS=almacen_secure_password_2026
DB_SSL=false
