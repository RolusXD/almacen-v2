<%- include('../layouts/header', { title: 'Movimientos de Accesorios', activeNav: 'mov-accesorios' }) %>

<div class="row g-3">
  <!-- Historial de Movimientos de Materiales (100% Ancho Full-Width) -->
  <div class="col-12">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title">
          <i class="bi bi-list-columns-reverse text-primary me-2"></i> Historial de Movimientos de Materiales
        </h3>
        <div class="card-tools d-flex align-items-center gap-2 ms-auto">
          <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalMovAccesorio">
            <i class="bi bi-box-arrow-up-right me-1"></i> Despachar Material
          </button>
          <span class="badge text-bg-primary"><%= movimientos.length %> Movimientos</span>
          <a href="/reportes/exportar/movimientos-accesorios" class="btn btn-outline-secondary btn-sm" title="Descargar Excel (.xlsx)">
            <i class="bi bi-file-earmark-excel text-success me-1"></i> Exportar (.xlsx)
          </a>
        </div>
      </div>

      <div class="card-body">
        <!-- Toolbar de Filtros y Búsqueda -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 bg-body-tertiary p-2 rounded border">
          <form method="GET" action="/movimientos/accesorios" class="d-flex flex-wrap align-items-center gap-2">
            <label class="form-label mb-0 small fw-bold text-body">Destino:</label>
            <select name="destino" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
              <option value="">Todos los destinos</option>
              <% destinos.forEach(d => { %>
                <option value="<%= d %>" <%= destinoFiltro === d ? 'selected' : '' %>><%= d %></option>
              <% }); %>
            </select>

            <div class="d-flex align-items-center gap-1">
              <input type="text" name="filtro" class="form-control form-control-sm" placeholder="Buscar material, técnico..." value="<%= filtro || '' %>" style="min-width: 200px;">
              <button type="submit" class="btn btn-primary btn-sm" title="Buscar"><i class="bi bi-search"></i></button>
              <% if (filtro || destinoFiltro) { %>
                <a href="/movimientos/accesorios" class="btn btn-outline-secondary btn-sm" title="Limpiar"><i class="bi bi-x-lg"></i></a>
              <% } %>
            </div>
          </form>

          <div class="small text-body-secondary ms-auto">
            Mostrando <strong class="text-body font-tabular"><%= movimientos.length %></strong> movimientos
          </div>
        </div>

        <!-- Tabla Oficial AdminLTE 4 / Bootstrap 5 -->
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>FECHA</th>
                <th>TIPO</th>
                <th>ACCESORIO / MATERIAL</th>
                <th class="text-end">CANTIDAD</th>
                <th>DESTINO</th>
                <th>ENCARGADO</th>
                <th>ASUNTO</th>
                <th>OBSERVACIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (movimientos && movimientos.length > 0) { %>
                <% movimientos.forEach(m => { %>
                  <tr>
                    <td class="font-tabular small"><%= m.fecha_movimiento ? new Date(m.fecha_movimiento).toISOString().split('T')[0] : '-' %></td>
                    <td>
                      <% if (m.tipo_movimiento === 'SALIDA') { %>
                        <span class="badge text-bg-danger">SALIDA</span>
                      <% } else { %>
                        <span class="badge text-bg-success">ENTRADA</span>
                      <% } %>
                    </td>
                    <td><strong><%= m.nombre_accesorio || '-' %></strong></td>
                    <td class="text-end font-tabular">
                      <span class="badge bg-body-secondary border text-body fw-semibold">
                        <%= m.cantidad %> <%= m.unidad_medida || 'UNIDADES' %>
                      </span>
                    </td>
                    <td>
                      <% if (m.destino) { %>
                        <span class="badge bg-body-secondary border text-body"><i class="bi bi-geo-alt me-1 text-primary"></i><%= m.destino %></span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><%= m.encargado %></td>
                    <td><small class="text-body-secondary"><%= m.asunto %></small></td>
                    <td><small class="text-body-secondary"><%= m.observaciones || '-' %></small></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-muted py-4">No hay movimientos registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Flotante de Registro de Movimiento de Accesorio -->
<div class="modal fade" id="modalMovAccesorio" tabindex="-1" aria-labelledby="modalMovAccesorioLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title fw-bold" id="modalMovAccesorioLabel">
          <i class="bi bi-box-arrow-up-right me-2"></i> Asignar / Despachar Material
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <form method="POST" action="/movimientos/accesorios" id="formMovAccesorio">
        <div class="modal-body p-4">
          <div class="row g-3">
            <!-- Selección de Accesorio -->
            <div class="col-12">
              <label class="form-label fw-semibold">
                <i class="bi bi-tools me-1 text-primary"></i> ACCESORIO / MATERIAL <span class="text-danger">*</span>
              </label>
              <select name="id_accesorio" id="selectAccesorio" class="form-select" required>
                <option value="">Seleccione accesorio...</option>
                <% accesoriosDisponibles.forEach(acc => { %>
                  <option value="<%= acc.id_accesorio %>" data-stock="<%= acc.cantidad %>" data-unidad="<%= acc.unidad_medida %>" <%= selectedId == acc.id_accesorio ? 'selected' : '' %>>
                    <%= acc.nombre %> <%= acc.codigo ? '(' + acc.codigo + ')' : '' %> [Disp: <%= acc.cantidad %> <%= acc.unidad_medida %>]
                  </option>
                <% }); %>
              </select>
              <div id="infoStock" class="mt-1 small text-primary fw-semibold"></div>
            </div>

            <!-- Tipo de Movimiento -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">TIPO DE MOVIMIENTO <span class="text-danger">*</span></label>
              <select name="tipo_movimiento" id="tipoMovAcc" class="form-select" required>
                <option value="SALIDA">SALIDA (Egreso de almacén / Asignación a técnico)</option>
                <option value="ENTRADA">ENTRADA (Retorno / Reingreso a almacén)</option>
              </select>
            </div>

            <!-- Cantidad a Mover -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">CANTIDAD A ASIGNAR / MOVER <span class="text-danger">*</span></label>
              <input type="number" name="cantidad" id="inputCantidad" class="form-control font-tabular" min="1" step="1" value="1" required>
              <small id="alertaStockExcedido" class="text-danger fw-bold d-none">
                <i class="bi bi-exclamation-triangle"></i> La cantidad supera el stock disponible en almacén.
              </small>
            </div>

            <!-- Campo Destino -->
            <div class="col-md-6" id="campoDestinoAcc">
              <label class="form-label fw-semibold">
                <i class="bi bi-geo-alt me-1 text-danger"></i> DESTINO <span class="text-danger">*</span>
              </label>
              <select name="destino" id="selectDestinoAcc" class="form-select" required>
                <option value="">Seleccione destino...</option>
                <option value="INSTALACIONES">INSTALACIONES (Clientes)</option>
                <option value="INFRAESTRUCTURA">INFRAESTRUCTURA (Nodos/Torres)</option>
                <option value="MANTENIMIENTO RED">MANTENIMIENTO DE RED</option>
                <option value="MANTENIMIENTO VEHICULOS">MANTENIMIENTO VEHÍCULOS</option>
                <option value="ADMINISTRACION">ADMINISTRACIÓN</option>
                <option value="SOPORTE TECNICO">SOPORTE TÉCNICO</option>
                <option value="OTROS">OTROS</option>
              </select>
            </div>

            <!-- Asunto -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">ASUNTO / MOTIVO <span class="text-danger">*</span></label>
              <select name="asunto" class="form-select" required>
                <option value="RCA">RCA (Requerimiento de Cambio/Alta)</option>
                <option value="INSTALACIÓN">INSTALACIÓN</option>
                <option value="MANTENIMIENTO">MANTENIMIENTO</option>
                <option value="AMPLIACION">AMPLIACIÓN DE RED</option>
                <option value="OTROS">OTROS</option>
              </select>
            </div>

            <!-- Encargado -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="bi bi-person me-1"></i> TÉCNICO / ENCARGADO <span class="text-danger">*</span>
              </label>
              <input type="text" name="encargado" class="form-control" placeholder="Nombre de quien retira o recibe..." required>
            </div>

            <!-- Fecha -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">FECHA <span class="text-danger">*</span></label>
              <input type="date" name="fecha_movimiento" class="form-control font-tabular" value="<%= new Date().toISOString().split('T')[0] %>" required>
            </div>

            <!-- Observaciones -->
            <div class="col-12">
              <label class="form-label fw-semibold">OBSERVACIONES</label>
              <input type="text" name="observaciones" class="form-control" placeholder="Metraje cortado, número de orden o notas...">
            </div>
          </div>
        </div>
        <div class="modal-footer bg-body-tertiary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" id="btnGuardarMovAcc" class="btn btn-success px-4">
            <i class="bi bi-check2-circle me-1"></i> Registrar Despacho
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Script de Validación Dinámica de Existencias -->
<script>
  const selectAcc = document.getElementById('selectAccesorio');
  const inputCant = document.getElementById('inputCantidad');
  const tipoMovAcc = document.getElementById('tipoMovAcc');
  const infoStock = document.getElementById('infoStock');
  const alertaStock = document.getElementById('alertaStockExcedido');
  const btnGuardar = document.getElementById('btnGuardarMovAcc');

  function validarStock() {
    const opt = selectAcc.options[selectAcc.selectedIndex];
    if (!opt || !opt.dataset.stock) {
      infoStock.textContent = '';
      alertaStock.classList.add('d-none');
      btnGuardar.disabled = false;
      return;
    }

    const stock = parseInt(opt.dataset.stock, 10);
    const unidad = opt.dataset.unidad || '';
    const cant = parseInt(inputCant.value, 10) || 0;
    const esSalida = tipoMovAcc.value === 'SALIDA';

    infoStock.textContent = 'Stock actual disponible: ' + stock + ' ' + unidad;

    if (esSalida && cant > stock) {
      alertaStock.classList.remove('d-none');
      btnGuardar.disabled = true;
    } else {
      alertaStock.classList.add('d-none');
      btnGuardar.disabled = false;
    }
  }

  selectAcc.addEventListener('change', validarStock);
  inputCant.addEventListener('input', validarStock);
  tipoMovAcc.addEventListener('change', validarStock);

  const modalMovAcc = document.getElementById('modalMovAccesorio');
  if (modalMovAcc) {
    modalMovAcc.addEventListener('shown.bs.modal', function() {
      selectAcc.focus();
      validarStock();
    });
  }

  validarStock();
</script>

<%- include('../layouts/footer') %>
