<!DOCTYPE html>
<html lang="es">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title>Recuperar Contraseña - Almacén TOI</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Google Font: Source Sans 3 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap Icons & AdminLTE 4 CSS Oficial -->
  <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/adminlte/css/adminlte.min.css">
  <link rel="stylesheet" href="/css/mikrowisp-style.css">
</head>
<body class="login-page bg-body-secondary d-flex align-items-center justify-content-center" style="min-height: 100vh;">
  <div class="login-box" style="width: 400px;">
    <div class="card card-outline card-primary shadow">
      <div class="card-header text-center py-3">
        <a href="/" class="link-dark text-decoration-none d-flex align-items-center justify-content-center">
          <i class="bi bi-shield-lock text-primary fs-2 me-2"></i>
          <h2 class="mb-0 fw-bold"><b>Almacén</b> TOI</h2>
        </a>
        <div class="text-body-secondary small text-uppercase fw-semibold mt-1">Recuperación de Contraseña</div>
      </div>
      <div class="card-body p-4">
        <p class="text-body-secondary small mb-3">
          Ingresa tu <strong>nombre de usuario</strong> o <strong>correo electrónico</strong> registrado. Te enviaremos un enlace seguro para restablecer tu contraseña.
        </p>

        <% if (error) { %>
          <div class="alert alert-danger small py-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <% if (success) { %>
          <div class="alert alert-success small py-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i>
            <span><%= success %></span>
          </div>
        <% } %>

        <% if (!success) { %>
          <form method="POST" action="/auth/forgot-password">
            <div class="mb-3">
              <label class="form-label fw-semibold">Usuario o Correo</label>
              <div class="input-group">
                <input type="text" name="identificador" class="form-control" placeholder="Ej: admin o admin@toi.bo" required autofocus>
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
              <i class="bi bi-send me-1"></i> Enviar Enlace de Recuperación
            </button>
          </form>
        <% } %>

        <div class="text-center mt-3 pt-2 border-top">
          <a href="/auth/login" class="text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Volver a Iniciar Sesión
          </a>
        </div>
      </div>
    </div>
  </div>

  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/adminlte/js/adminlte.min.js"></script>
</body>
</html>
