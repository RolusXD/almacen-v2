<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión - Almacén TOI v4</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/mikrowisp-style.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .login-box {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border-radius: 10px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
      overflow: hidden;
    }
    .login-header {
      background: #172230;
      color: #ffffff;
      padding: 1.75rem 1.5rem;
      text-align: center;
    }
    .login-body {
      padding: 1.75rem 1.75rem;
    }
    .login-field {
      margin-bottom: 1.15rem;
    }
    .login-field label {
      display: block;
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #475569;
      margin-bottom: 0.35rem;
    }
    .login-field input {
      width: 100%;
      padding: 0.65rem 0.85rem;
      font-size: 13.5px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      outline: none;
      transition: all 0.15s ease;
    }
    .login-field input:focus {
      border-color: #0284c7;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }
  </style>
</head>
<body>
  <div class="login-box">
    <div class="login-header">
      <i class="bi bi-boxes" style="font-size: 2.4rem; color: #38bdf8;"></i>
      <h2 style="font-size: 1.35rem; font-weight: 700; margin: 0.5rem 0 0.2rem; color: #ffffff;">Almacén TOI</h2>
      <div style="font-size: 0.78rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Sistema de Control de Inventario</div>
    </div>
    <div class="login-body">
      <% if (error) { %>
        <div class="mw-alert mw-alert-danger">
          <i class="bi bi-exclamation-circle-fill"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/auth/login">
        <div class="login-field">
          <label for="usuario"><i class="bi bi-person me-1"></i> Usuario</label>
          <input type="text" id="usuario" name="usuario" placeholder="Ej: admin" required autofocus autocomplete="username">
        </div>
        <div class="login-field">
          <label for="password"><i class="bi bi-lock me-1"></i> Contraseña</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="mw-btn mw-btn-primary w-100" style="padding: 0.65rem; font-size: 13.5px; justify-content: center; margin-top: 0.5rem;">
          <i class="bi bi-box-arrow-in-right"></i> Ingresar al Sistema
        </button>
      </form>

      <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #f1f5f9; text-align: center; font-size: 11.5px; color: #94a3b8;">
        <div>Credenciales iniciales: <code>admin</code> / <code>Admin123!</code></div>
        <div style="margin-top: 0.35rem;">Telecomunicaciones Oportunas Inteligentes &copy; 2026</div>
      </div>
    </div>
  </div>
</body>
</html>
