<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso al Sistema - Almacén TOI (WMS Pro)</title>
  
  <!-- Tipografía Limpia Inter & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/mikrowisp-style.css" rel="stylesheet">
  <style>
    body {
      background-color: #0F172A;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      margin: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .login-box {
      width: 100%;
      max-width: 410px;
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
      overflow: hidden;
    }
    .login-header {
      background: #0F172A;
      color: #FFFFFF;
      padding: 1.75rem 1.5rem 1.5rem;
      text-align: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .login-body {
      padding: 1.75rem 1.75rem 1.5rem;
    }
    .login-field {
      margin-bottom: 1.15rem;
    }
    .login-field label {
      display: block;
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #475569;
      margin-bottom: 0.35rem;
    }
    .login-field input {
      width: 100%;
      padding: 0.65rem 0.85rem;
      font-size: 13.5px;
      border: 1px solid #CBD5E1;
      border-radius: 6px;
      outline: none;
      transition: all 0.15s ease;
      min-height: 42px;
    }
    .login-field input:focus {
      border-color: #1D4ED8;
      box-shadow: 0 0 0 2px rgba(29, 78, 216, 0.15);
    }
  </style>
</head>
<body>
  <div class="login-box">
    <div class="login-header">
      <div style="width: 48px; height: 48px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 0.5rem;">
        <i class="bi bi-boxes" style="font-size: 1.65rem; color: #38BDF8;"></i>
      </div>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 0.35rem 0 0.15rem; color: #FFFFFF; letter-spacing: -0.2px;">Almacén TOI</h2>
      <div style="font-size: 0.72rem; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.6px; font-weight: 600;">WMS UI Pro • Gestión Operativa</div>
    </div>
    <div class="login-body">
      <% if (error) { %>
        <div class="mw-alert mw-alert-danger mb-3">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/auth/login">
        <div class="login-field">
          <label for="usuario"><i class="bi bi-person me-1"></i> Usuario</label>
          <input type="text" id="usuario" name="usuario" placeholder="Ej: admin" required autofocus autocomplete="username">
        </div>
        <div class="login-field">
          <label for="password"><i class="bi bi-lock me-1"></i> Contraseña</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="mw-btn mw-btn-primary w-100 mw-btn-touch" style="margin-top: 0.5rem; justify-content: center;">
          <i class="bi bi-box-arrow-in-right"></i> Ingresar al Sistema
        </button>
      </form>

      <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #F1F5F9; text-align: center; font-size: 11.5px; color: #64748B;">
        <div>Acceso inicial: <span class="font-mono" style="font-size: 11px;">admin</span> / <span class="font-mono" style="font-size: 11px;">Admin123!</span></div>
        <div style="margin-top: 0.4rem; color: #94A3B8;">Telecomunicaciones Oportunas Inteligentes &copy; 2026</div>
      </div>
    </div>
  </div>
</body>
</html>
