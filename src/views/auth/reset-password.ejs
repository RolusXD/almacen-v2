<!DOCTYPE html>
<html lang="es">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title>Restablecer Contraseña - Almacén TOI</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Google Font: Source Sans 3 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap Icons & AdminLTE 4 CSS Oficial -->
  <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/adminlte/css/adminlte.min.css">
  <link rel="stylesheet" href="/css/mikrowisp-style.css">
</head>
<body class="login-page bg-body-secondary d-flex align-items-center justify-content-center" style="min-height: 100vh;">
  <div class="login-box" style="width: 400px;">
    <div class="card card-outline card-success shadow">
      <div class="card-header text-center py-3">
        <a href="/" class="link-dark text-decoration-none d-flex align-items-center justify-content-center">
          <i class="bi bi-key-fill text-success fs-2 me-2"></i>
          <h2 class="mb-0 fw-bold"><b>Almacén</b> TOI</h2>
        </a>
        <div class="text-body-secondary small text-uppercase fw-semibold mt-1">Crear Nueva Contraseña</div>
      </div>
      <div class="card-body p-4">
        <p class="text-body-secondary small mb-3">
          Usuario: <strong class="text-primary"><%= usuario %></strong><br>
          Ingresa y confirma tu nueva contraseña de acceso.
        </p>

        <% if (error) { %>
          <div class="alert alert-danger small py-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form method="POST" action="/auth/reset-password">
          <input type="hidden" name="token" value="<%= token %>">

          <div class="mb-3">
            <label class="form-label fw-semibold">Nueva Contraseña</label>
            <div class="input-group">
              <input type="password" name="password" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6" autofocus>
              <span class="input-group-text"><i class="bi bi-lock"></i></span>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Confirmar Nueva Contraseña</label>
            <div class="input-group">
              <input type="password" name="confirmar_password" class="form-control" placeholder="Repite la contraseña" required minlength="6">
              <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>
            </div>
          </div>

          <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
            <i class="bi bi-shield-check me-1"></i> Guardar Nueva Contraseña
          </button>
        </form>

        <div class="text-center mt-3 pt-2 border-top">
          <a href="/auth/login" class="text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Cancelar y volver al Login
          </a>
        </div>
      </div>
    </div>
  </div>

  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/adminlte/js/adminlte.min.js"></script>
</body>
</html>
