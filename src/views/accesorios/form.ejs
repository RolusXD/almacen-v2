<%- include('../layouts/header', { title: accesorio ? 'Editar Accesorio' : 'Nuevo Accesorio', activeNav: 'accesorios' }) %>

<div class="row justify-content-center">
  <div class="col-12 col-xl-10">
    <div class="card card-success card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">
          <i class="bi <%= accesorio ? 'bi-pencil-square text-primary' : 'bi-plus-circle text-success' %> me-2"></i>
          <span><%= accesorio ? 'Editar Accesorio: ' + accesorio.nombre : 'Registro de Nuevo Accesorio / Material' %></span>
        </h3>
        <div class="card-tools ms-auto">
          <a href="/accesorios" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver a Accesorios
          </a>
        </div>
      </div>

      <div class="card-body">
        <form method="POST" action="<%= accesorio ? '/accesorios/editar/' + accesorio.id_accesorio : '/accesorios/nuevo' %>">
          
          <!-- SECCIÓN 1: IDENTIFICACIÓN -->
          <div class="p-2 bg-light border-start border-success border-3 mb-3 rounded">
            <span class="fw-bold text-dark small text-uppercase">
              <i class="bi bi-tools me-1 text-success"></i> 1. Identificación del Material
            </span>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-8">
              <label class="form-label fw-semibold">DESCRIPCIÓN / NOMBRE DEL MATERIAL <span class="text-danger">*</span></label>
              <input type="text" name="nombre" class="form-control" placeholder="Ej: FIBRA ADSS 6 HILOS o CONECTOR SC/APC" value="<%= accesorio ? accesorio.nombre : '' %>" required autofocus>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">CÓDIGO REFERENCIAL / SKU</label>
              <input type="text" name="codigo" class="form-control font-mono" placeholder="Ej: FADD-6H, CON-APC" value="<%= accesorio ? accesorio.codigo : '' %>">
            </div>
          </div>

          <!-- SECCIÓN 2: STOCK Y COSTOS -->
          <div class="p-2 bg-light border-start border-primary border-3 mt-4 mb-3 rounded">
            <span class="fw-bold text-dark small text-uppercase">
              <i class="bi bi-boxes me-1 text-primary"></i> 2. Control de Stock y Valoración
            </span>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">CANTIDAD EN STOCK <span class="text-danger">*</span></label>
              <input type="number" name="cantidad" class="form-control font-tabular text-end" min="0" step="1" value="<%= accesorio ? accesorio.cantidad : 1 %>" required>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">UNIDAD DE MEDIDA <span class="text-danger">*</span></label>
              <select name="unidad_medida" class="form-select" required>
                <% const unidades = ['METROS', 'UNIDADES', 'CAJAS', 'KILOS', 'LITROS', 'PARES']; %>
                <% unidades.forEach(u => { %>
                  <option value="<%= u %>" <%= accesorio && accesorio.unidad_medida === u ? 'selected' : (u === 'UNIDADES' && !accesorio ? 'selected' : '') %>><%= u %></option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">PRECIO / COSTO UNIT. (Bs.)</label>
              <input type="number" step="0.01" name="costo" class="form-control font-tabular text-end" placeholder="0.00" value="<%= accesorio ? accesorio.costo : '0.00' %>">
            </div>
          </div>

          <!-- SECCIÓN 3: CLASIFICACIÓN Y ORIGEN -->
          <div class="p-2 bg-light border-start border-info border-3 mt-4 mb-3 rounded">
            <span class="fw-bold text-dark small text-uppercase">
              <i class="bi bi-tag me-1 text-info"></i> 3. Clasificación y Proveedor
            </span>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">CATEGORÍA</label>
              <select name="id_categoria" class="form-select">
                <option value="">Sin categoría...</option>
                <% if (typeof categorias !== 'undefined' && categorias) { %>
                  <% categorias.forEach(c => { %>
                    <option value="<%= c.id_categoria %>" <%= accesorio && accesorio.id_categoria === c.id_categoria ? 'selected' : '' %>>
                      <%= c.nombre %>
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">PROVEEDOR</label>
              <select name="id_proveedor" class="form-select">
                <option value="">Seleccione proveedor...</option>
                <% proveedores.forEach(p => { %>
                  <option value="<%= p.id_proveedor %>" <%= accesorio && accesorio.id_proveedor === p.id_proveedor ? 'selected' : '' %>>
                    <%= p.nombre_empresa %> <%= p.nit ? '(NIT: ' + p.nit + ')' : '' %>
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">FECHA ENTRADA <span class="text-danger">*</span></label>
              <input type="date" name="fecha_entrada" class="form-control font-tabular" value="<%= accesorio && accesorio.fecha_entrada ? new Date(accesorio.fecha_entrada).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>" required>
            </div>
          </div>

          <!-- SECCIÓN 4: CALIDAD Y OBSERVACIONES -->
          <div class="p-2 bg-light border-start border-warning border-3 mt-4 mb-3 rounded">
            <span class="fw-bold text-dark small text-uppercase">
              <i class="bi bi-chat-left-text me-1 text-warning"></i> 4. Calidad y Observaciones
            </span>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label fw-semibold">CALIDAD ESTÁNDAR</label>
              <input type="text" class="form-control" value="NUEVO (Calidad Garantizada)" readonly style="background-color: #e9ecef; font-weight: 700; color: #198754; cursor: not-allowed;">
              <input type="hidden" name="calidad" value="NUEVO">
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">OBSERVACIONES</label>
              <input type="text" name="observaciones" class="form-control" placeholder="Detalles de bobina, lote, notas especiales..." value="<%= accesorio ? accesorio.observaciones : '' %>">
            </div>
          </div>

          <div class="d-flex align-items-center gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-success px-4">
              <i class="bi bi-save me-1"></i> <%= accesorio ? 'Guardar Cambios' : 'Registrar Accesorio en Bodega' %>
            </button>
            <a href="/accesorios" class="btn btn-outline-secondary px-3">
              Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
