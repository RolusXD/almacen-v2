<%- include('../layouts/header', { title: 'Gestión de Accesorios', activeNav: 'accesorios' }) %>

<div class="mw-card">
  <div class="mw-card-header">
    <div class="mw-card-title">
      <i class="bi bi-tools text-primary"></i> Catálogo y Existencias de Materiales / Accesorios
    </div>
    <div class="d-flex gap-2">
      <a href="/accesorios/nuevo" class="mw-btn mw-btn-primary mw-btn-touch">
        <i class="bi bi-plus-lg"></i> + Nuevo Material
      </a>
      <a href="/movimientos/accesorios" class="mw-btn mw-btn-outline mw-btn-touch">
        <i class="bi bi-box-arrow-up-right text-primary"></i> Despachar Material
      </a>
      <a href="/reportes/exportar/accesorios" class="mw-btn mw-btn-outline mw-btn-touch" title="Descargar Excel (.xlsx)">
        <i class="bi bi-file-earmark-excel text-success"></i> Exportar (.xlsx)
      </a>
    </div>
  </div>

  <div class="mw-card-body">
    <!-- Toolbar de Filtros WMS UI PRO -->
    <div class="mw-toolbar">
      <form method="GET" action="/accesorios" class="mw-toolbar-group">
        <label class="text-muted" style="font-size: 11.5px; font-weight: 600;">Unidad:</label>
        <select name="unidad" class="mw-select" onchange="this.form.submit()">
          <option value="Todas" <%= unidadFiltro === 'Todas' ? 'selected' : '' %>>Todas las unidades</option>
          <option value="METROS" <%= unidadFiltro === 'METROS' ? 'selected' : '' %>>METROS</option>
          <option value="UNIDADES" <%= unidadFiltro === 'UNIDADES' ? 'selected' : '' %>>UNIDADES</option>
          <option value="CAJAS" <%= unidadFiltro === 'CAJAS' ? 'selected' : '' %>>CAJAS</option>
          <option value="KILOS" <%= unidadFiltro === 'KILOS' ? 'selected' : '' %>>KILOS</option>
          <option value="PARES" <%= unidadFiltro === 'PARES' ? 'selected' : '' %>>PARES</option>
        </select>

        <div class="form-check d-inline-flex align-items-center gap-1 ms-2" style="font-size: 12px;">
          <input type="checkbox" name="stockBajo" id="checkStockBajo" value="1" <%= stockBajoFiltro ? 'checked' : '' %> onchange="this.form.submit()" class="form-check-input">
          <label for="checkStockBajo" class="form-check-label text-danger fw-bold">Solo Stock Crítico (< 10)</label>
        </div>

        <div class="d-flex align-items-center gap-1 ms-2">
          <input type="text" name="filtro" class="mw-input" placeholder="Buscar material o SKU..." value="<%= filtro || '' %>" style="min-width: 220px;">
          <button type="submit" class="mw-btn mw-btn-primary mw-btn-sm" title="Buscar"><i class="bi bi-search"></i></button>
          <% if (filtro || (unidadFiltro && unidadFiltro !== 'Todas') || stockBajoFiltro) { %>
            <a href="/accesorios" class="mw-btn mw-btn-outline mw-btn-sm" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>

      <div class="text-muted" style="font-size: 11.5px;">
        Mostrando <strong class="text-dark font-tabular"><%= accesorios.length %></strong> ítem(s)
      </div>
    </div>

    <!-- Tabla Compacta de Accesorios WMS UI PRO -->
    <div class="mw-table-container">
      <table class="mw-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>CÓDIGO / SKU</th>
            <th>DESCRIPCIÓN / MATERIAL</th>
            <th class="col-number">STOCK ACTUAL</th>
            <th>UNIDAD</th>
            <th class="col-number">COSTO UNIT. (Bs.)</th>
            <th>PROVEEDOR</th>
            <th>CALIDAD</th>
            <th class="actions-cell">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          <% if (accesorios && accesorios.length > 0) { %>
            <% accesorios.forEach(a => { %>
              <tr>
                <td class="font-tabular"><small class="text-muted">#<%= a.id_accesorio %></small></td>
                <td>
                  <% if (a.codigo) { %>
                    <span class="font-mono">
                      <%= a.codigo %>
                      <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= a.codigo %>', 'Código SKU')" title="Copiar código">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td><strong><%= a.nombre %></strong></td>
                <td class="col-number font-tabular">
                  <% if (a.cantidad <= 0) { %>
                    <span class="badge-mw badge-wms-critico font-tabular">
                      <i class="bi bi-x-circle me-1"></i>0 AGOTADO
                    </span>
                  <% } else if (a.cantidad < 10) { %>
                    <span class="badge-mw badge-wms-bajo font-tabular">
                      <i class="bi bi-exclamation-triangle me-1"></i><%= a.cantidad %> CRÍTICO
                    </span>
                  <% } else { %>
                    <span class="badge-mw badge-wms-optimo font-tabular">
                      <i class="bi bi-check2 me-1"></i><%= a.cantidad %>
                    </span>
                  <% } %>
                </td>
                <td>
                  <span class="badge-mw badge-neutral"><%= a.unidad_medida %></span>
                </td>
                <td class="col-number font-tabular">
                  Bs. <%= Number(a.costo || 0).toFixed(2) %>
                </td>
                <td><%= a.nombre_proveedor || '-' %></td>
                <td>
                  <span class="badge-mw badge-neutral text-primary" style="font-size: 10px;">NUEVO</span>
                </td>
                <td class="actions-cell">
                  <a href="/movimientos/accesorios?id_accesorio=<%= a.id_accesorio %>" class="mw-btn mw-btn-outline mw-btn-sm mw-btn-icon text-success" title="Registrar Egreso o Ingreso">
                    <i class="bi bi-arrow-left-right"></i>
                  </a>
                  <a href="/accesorios/editar/<%= a.id_accesorio %>" class="mw-btn mw-btn-outline mw-btn-sm mw-btn-icon text-primary" title="Editar">
                    <i class="bi bi-pencil-square"></i>
                  </a>
                  <a href="/accesorios/eliminar/<%= a.id_accesorio %>" class="mw-btn mw-btn-danger-outline mw-btn-sm mw-btn-icon" title="Eliminar" onclick="return confirm('¿Seguro que desea eliminar <%= a.nombre %>?');">
                    <i class="bi bi-trash"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                No se encontraron materiales que coincidan con la búsqueda.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
