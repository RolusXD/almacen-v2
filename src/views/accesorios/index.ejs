<%- include('../layouts/header', { title: 'Gestión de Accesorios', activeNav: 'accesorios' }) %>

<div class="card card-success card-outline shadow-sm mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h3 class="card-title">
      <i class="bi bi-tools text-success me-2"></i> Catálogo y Existencias de Materiales / Accesorios
    </h3>
    <div class="card-tools d-flex gap-2 ms-auto">
      <a href="/accesorios/nuevo" class="btn btn-success btn-sm">
        <i class="bi bi-plus-lg me-1"></i> + Nuevo Material
      </a>
      <a href="/movimientos/accesorios" class="btn btn-primary btn-sm">
        <i class="bi bi-box-arrow-up-right me-1"></i> Despachar Material
      </a>
      <a href="/reportes/exportar/accesorios" class="btn btn-outline-secondary btn-sm" title="Descargar Excel (.xlsx)">
        <i class="bi bi-file-earmark-excel text-success me-1"></i> Exportar (.xlsx)
      </a>
    </div>
  </div>

  <div class="card-body">
    <!-- Toolbar de Filtros y Búsqueda AdminLTE 4 / Bootstrap 5 -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 bg-light p-2 rounded border">
      <form method="GET" action="/accesorios" class="d-flex flex-wrap align-items-center gap-2">
        <label class="form-label mb-0 small fw-bold text-secondary">Unidad:</label>
        <select name="unidad" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
          <option value="Todas" <%= unidadFiltro === 'Todas' ? 'selected' : '' %>>Todas las unidades</option>
          <option value="METROS" <%= unidadFiltro === 'METROS' ? 'selected' : '' %>>METROS</option>
          <option value="UNIDADES" <%= unidadFiltro === 'UNIDADES' ? 'selected' : '' %>>UNIDADES</option>
          <option value="CAJAS" <%= unidadFiltro === 'CAJAS' ? 'selected' : '' %>>CAJAS</option>
          <option value="KILOS" <%= unidadFiltro === 'KILOS' ? 'selected' : '' %>>KILOS</option>
          <option value="PARES" <%= unidadFiltro === 'PARES' ? 'selected' : '' %>>PARES</option>
        </select>

        <div class="form-check d-inline-flex align-items-center gap-1 ms-2 mb-0">
          <input type="checkbox" name="stockBajo" id="checkStockBajo" value="1" <%= stockBajoFiltro ? 'checked' : '' %> onchange="this.form.submit()" class="form-check-input">
          <label for="checkStockBajo" class="form-check-label text-danger fw-bold small">Solo Stock Crítico (< 10)</label>
        </div>

        <div class="d-flex align-items-center gap-1 ms-2">
          <input type="text" name="filtro" class="form-control form-control-sm" placeholder="Buscar material o SKU..." value="<%= filtro || '' %>" style="min-width: 220px;">
          <button type="submit" class="btn btn-primary btn-sm" title="Buscar"><i class="bi bi-search"></i></button>
          <% if (filtro || (unidadFiltro && unidadFiltro !== 'Todas') || stockBajoFiltro) { %>
            <a href="/accesorios" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>

      <div class="small text-muted ms-auto">
        Mostrando <strong class="text-dark font-tabular"><%= accesorios.length %></strong> ítem(s)
      </div>
    </div>

    <!-- Tabla Oficial AdminLTE 4 / Bootstrap 5 -->
    <div class="table-responsive">
      <table class="table table-bordered table-striped table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 60px;">ID</th>
            <th>CÓDIGO / SKU</th>
            <th>DESCRIPCIÓN / MATERIAL</th>
            <th class="text-end">STOCK ACTUAL</th>
            <th>UNIDAD</th>
            <th class="text-end">COSTO UNIT. (Bs.)</th>
            <th>PROVEEDOR</th>
            <th>CALIDAD</th>
            <th class="text-end">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          <% if (accesorios && accesorios.length > 0) { %>
            <% accesorios.forEach(a => { %>
              <tr>
                <td class="text-muted font-tabular small">#<%= a.id_accesorio %></td>
                <td>
                  <% if (a.codigo) { %>
                    <span class="font-mono text-primary fw-semibold">
                      <%= a.codigo %>
                      <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= a.codigo %>', 'Código SKU')" title="Copiar código">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td><strong><%= a.nombre %></strong></td>
                <td class="text-end font-tabular">
                  <% if (a.cantidad <= 0) { %>
                    <span class="badge text-bg-danger">
                      <i class="bi bi-x-circle me-1"></i>0 AGOTADO
                    </span>
                  <% } else if (a.cantidad < 10) { %>
                    <span class="badge text-bg-warning">
                      <i class="bi bi-exclamation-triangle me-1"></i><%= a.cantidad %> CRÍTICO
                    </span>
                  <% } else { %>
                    <span class="badge text-bg-success">
                      <i class="bi bi-check2 me-1"></i><%= a.cantidad %>
                    </span>
                  <% } %>
                </td>
                <td>
                  <span class="badge text-bg-secondary"><%= a.unidad_medida %></span>
                </td>
                <td class="text-end font-tabular">
                  Bs. <%= Number(a.costo || 0).toFixed(2) %>
                </td>
                <td><%= a.nombre_proveedor || '-' %></td>
                <td>
                  <span class="badge text-bg-info">NUEVO</span>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/movimientos/accesorios?id_accesorio=<%= a.id_accesorio %>" class="btn btn-outline-success" title="Registrar Salida / Ingreso">
                      <i class="bi bi-arrow-left-right"></i>
                    </a>
                    <a href="/accesorios/editar/<%= a.id_accesorio %>" class="btn btn-outline-secondary" title="Editar">
                      <i class="bi bi-pencil-square"></i>
                    </a>
                    <a href="/accesorios/eliminar/<%= a.id_accesorio %>" class="btn btn-outline-danger" title="Eliminar" onclick="return confirm('¿Seguro que desea eliminar <%= a.nombre %>?');">
                      <i class="bi bi-trash"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                No se encontraron materiales que coincidan con la búsqueda.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
