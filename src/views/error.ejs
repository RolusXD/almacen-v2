<%- include('layouts/header', { title: 'Aviso del Sistema', activeNav: '' }) %>

<div class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-6 text-center">
    <div class="card card-outline card-danger shadow-sm p-4">
      <div class="mb-3">
        <i class="bi <%= status === 404 ? 'bi-question-circle text-warning' : 'bi-exclamation-octagon text-danger' %>" style="font-size: 3.5rem;"></i>
      </div>
      <h4 class="fw-bold text-body mb-2"><%= status === 404 ? 'Página no encontrada (404)' : 'Error de Operación (500)' %></h4>
      <p class="text-muted mb-4"><%= message || 'Ocurrió un evento inesperado en el procesamiento de la solicitud.' %></p>
      
      <div class="d-flex justify-content-center gap-2">
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Volver atrás
        </a>
        <a href="/dashboard" class="btn btn-primary">
          <i class="bi bi-speedometer2 me-1"></i> Ir al Dashboard
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('layouts/footer') %>
