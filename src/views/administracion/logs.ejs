<%- include('../layouts/header', { title: 'Bitácora y Logs de Auditoría', activeNav: 'admin-logs' }) %>

<div class="row g-3">
  <div class="col-12">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title text-body mb-0">
          <i class="bi bi-shield-check text-primary me-2"></i> Bitácora de Eventos y Auditoría del Sistema
        </h3>
        <div class="card-tools d-flex align-items-center gap-2 ms-auto">
          <span class="badge text-bg-primary"><%= total %> Registros Totales</span>
          <a href="/administracion/logs/exportar/excel?fechaInicio=<%= filtros.fechaInicio || '' %>&fechaFin=<%= filtros.fechaFin || '' %>&idUsuario=<%= filtros.idUsuario || '' %>&modulo=<%= filtros.modulo || '' %>&accion=<%= filtros.accion || '' %>" class="btn btn-outline-secondary btn-sm" title="Exportar historial a Excel (.xlsx)">
            <i class="bi bi-file-earmark-excel text-success me-1"></i> Exportar (.xlsx)
          </a>
        </div>
      </div>

      <div class="card-body">
        <!-- Toolbar de Filtros -->
        <div class="bg-body-tertiary p-3 rounded border mb-3">
          <form method="GET" action="/administracion/logs" class="row g-2 align-items-end">
            <div class="col-md-2 col-sm-6">
              <label class="form-label small fw-semibold text-body mb-1">Desde:</label>
              <input type="date" name="fechaInicio" class="form-control form-control-sm font-tabular" value="<%= filtros.fechaInicio || '' %>">
            </div>

            <div class="col-md-2 col-sm-6">
              <label class="form-label small fw-semibold text-body mb-1">Hasta:</label>
              <input type="date" name="fechaFin" class="form-control form-control-sm font-tabular" value="<%= filtros.fechaFin || '' %>">
            </div>

            <div class="col-md-2 col-sm-6">
              <label class="form-label small fw-semibold text-body mb-1">Usuario:</label>
              <select name="idUsuario" class="form-select form-select-sm">
                <option value="">Todos los usuarios</option>
                <% usuarios.forEach(u => { %>
                  <option value="<%= u.id_usuario %>" <%= filtros.idUsuario === u.id_usuario ? 'selected' : '' %>>
                    <%= u.nombre_completo %> (<%= u.usuario %>)
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-2 col-sm-6">
              <label class="form-label small fw-semibold text-body mb-1">Módulo:</label>
              <select name="modulo" class="form-select form-select-sm">
                <option value="TODOS" <%= filtros.modulo === 'TODOS' ? 'selected' : '' %>>Todos los módulos</option>
                <option value="AUTENTICACION" <%= filtros.modulo === 'AUTENTICACION' ? 'selected' : '' %>>Autenticación</option>
                <option value="DESPACHOS" <%= filtros.modulo === 'DESPACHOS' ? 'selected' : '' %>>Despachos</option>
                <option value="USUARIOS" <%= filtros.modulo === 'USUARIOS' ? 'selected' : '' %>>Usuarios</option>
                <option value="CONFIG_GENERAL" <%= filtros.modulo === 'CONFIG_GENERAL' ? 'selected' : '' %>>Config. General</option>
                <option value="CONFIG_SMTP" <%= filtros.modulo === 'CONFIG_SMTP' ? 'selected' : '' %>>Config. SMTP</option>
                <option value="MAESTROS" <%= filtros.modulo === 'MAESTROS' ? 'selected' : '' %>>Gestión Maestra</option>
              </select>
            </div>

            <div class="col-md-2 col-sm-6">
              <label class="form-label small fw-semibold text-body mb-1">Acción:</label>
              <select name="accion" class="form-select form-select-sm">
                <option value="TODOS" <%= filtros.accion === 'TODOS' ? 'selected' : '' %>>Todas las acciones</option>
                <option value="LOGIN_SUCCESS" <%= filtros.accion === 'LOGIN_SUCCESS' ? 'selected' : '' %>>LOGIN EXITOSO</option>
                <option value="LOGIN_FAILED" <%= filtros.accion === 'LOGIN_FAILED' ? 'selected' : '' %>>LOGIN FALLIDO</option>
                <option value="LOGOUT" <%= filtros.accion === 'LOGOUT' ? 'selected' : '' %>>LOGOUT</option>
                <option value="CREAR" <%= filtros.accion === 'CREAR' ? 'selected' : '' %>>CREAR</option>
                <option value="EDITAR" <%= filtros.accion === 'EDITAR' ? 'selected' : '' %>>EDITAR</option>
                <option value="ELIMINAR" <%= filtros.accion === 'ELIMINAR' ? 'selected' : '' %>>ELIMINAR</option>
                <option value="DESPACHO_CONFIRMADO" <%= filtros.accion === 'DESPACHO_CONFIRMADO' ? 'selected' : '' %>>DESPACHO CONFIRMADO</option>
                <option value="DESPACHO_ANULADO" <%= filtros.accion === 'DESPACHO_ANULADO' ? 'selected' : '' %>>DESPACHO ANULADO</option>
                <option value="CONFIG_UPDATE" <%= filtros.accion === 'CONFIG_UPDATE' ? 'selected' : '' %>>CONFIGURACIÓN</option>
                <option value="TEST_SMTP" <%= filtros.accion === 'TEST_SMTP' ? 'selected' : '' %>>PRUEBA SMTP</option>
              </select>
            </div>

            <div class="col-md-2 col-sm-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary btn-sm flex-fill">
                <i class="bi bi-funnel me-1"></i> Filtrar
              </button>
              <a href="/administracion/logs" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros">
                <i class="bi bi-x-lg"></i>
              </a>
            </div>
          </form>
        </div>

        <!-- Tabla de Auditoría (100% Full-Width) -->
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width: 70px;">ID</th>
                <th style="width: 170px;">FECHA Y HORA</th>
                <th style="width: 180px;">USUARIO</th>
                <th style="width: 100px;">ROL</th>
                <th style="width: 130px;">DIRECCIÓN IP</th>
                <th style="width: 140px;">MÓDULO</th>
                <th style="width: 160px;">ACCIÓN</th>
                <th>DETALLE / OBSERVACIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(log => { %>
                  <tr>
                    <td class="font-tabular text-body-secondary"><%= log.id_log %></td>
                    <td class="font-tabular fw-semibold text-body">
                      <%= formatDate(log.fecha_hora) %>
                    </td>
                    <td>
                      <strong><%= log.nombre_usuario %></strong>
                    </td>
                    <td>
                      <span class="badge <%= log.rol_usuario === 'admin' ? 'text-bg-primary' : 'bg-body-secondary text-body border' %>">
                        <%= log.rol_usuario %>
                      </span>
                    </td>
                    <td class="font-mono small text-body-secondary"><%= log.ip %></td>
                    <td>
                      <span class="badge bg-body-secondary text-body border"><%= log.modulo %></span>
                    </td>
                    <td>
                      <% if (['LOGIN_SUCCESS', 'CREAR', 'DESPACHO_CONFIRMADO'].includes(log.accion)) { %>
                        <span class="badge text-bg-success"><%= log.accion %></span>
                      <% } else if (['LOGIN_FAILED', 'ELIMINAR', 'DESPACHO_ANULADO'].includes(log.accion)) { %>
                        <span class="badge text-bg-danger"><%= log.accion %></span>
                      <% } else if (['EDITAR', 'PASSWORD_RESET', 'TOGGLE_ESTADO'].includes(log.accion)) { %>
                        <span class="badge text-bg-primary"><%= log.accion %></span>
                      <% } else { %>
                        <span class="badge text-bg-warning"><%= log.accion %></span>
                      <% } %>
                    </td>
                    <td>
                      <small class="text-body"><%= log.detalle || '-' %></small>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                    No se encontraron registros de auditoría con los filtros aplicados.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Paginación -->
        <% if (totalPages > 1) { %>
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-2 border-top">
            <span class="small text-body-secondary">
              Página <%= page %> de <%= totalPages %> (Total: <%= total %> registros)
            </span>
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/administracion/logs?page=<%= page - 1 %>&fechaInicio=<%= filtros.fechaInicio || '' %>&fechaFin=<%= filtros.fechaFin || '' %>&idUsuario=<%= filtros.idUsuario || '' %>&modulo=<%= filtros.modulo || '' %>&accion=<%= filtros.accion || '' %>">
                  &laquo; Anterior
                </a>
              </li>
              <% for (let p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
                <li class="page-item <%= p === page ? 'active' : '' %>">
                  <a class="page-link" href="/administracion/logs?page=<%= p %>&fechaInicio=<%= filtros.fechaInicio || '' %>&fechaFin=<%= filtros.fechaFin || '' %>&idUsuario=<%= filtros.idUsuario || '' %>&modulo=<%= filtros.modulo || '' %>&accion=<%= filtros.accion || '' %>">
                    <%= p %>
                  </a>
                </li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="/administracion/logs?page=<%= page + 1 %>&fechaInicio=<%= filtros.fechaInicio || '' %>&fechaFin=<%= filtros.fechaFin || '' %>&idUsuario=<%= filtros.idUsuario || '' %>&modulo=<%= filtros.modulo || '' %>&accion=<%= filtros.accion || '' %>">
                  Siguiente &raquo;
                </a>
              </li>
            </ul>
          </div>
        <% } %>

      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
