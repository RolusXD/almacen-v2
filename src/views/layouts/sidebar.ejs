<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
  <!-- Brand Logo -->
  <div class="sidebar-brand">
    <a href="/dashboard" class="brand-link text-decoration-none d-flex align-items-center">
      <i class="bi bi-boxes brand-image text-primary fs-4 me-2"></i>
      <span class="brand-text fw-bold text-white">Almacén TOI</span>
    </a>
  </div>

  <!-- Sidebar Wrapper -->
  <div class="sidebar-wrapper">
    <!-- User Panel -->
    <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center px-3 border-bottom border-secondary">
      <div class="image me-2">
        <i class="bi bi-person-circle fs-3 text-info"></i>
      </div>
      <div class="info">
        <a href="#" class="d-block text-decoration-none fw-semibold text-white"><%= user ? user.nombre_completo : 'Administrador' %></a>
        <small class="text-success"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>En línea</small>
      </div>
    </div>

    <!-- Sidebar Navigation Menu -->
    <nav class="mt-2">
      <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
        
        <li class="nav-header text-uppercase text-secondary fw-bold" style="font-size: 11px;">Módulos Principales</li>
        <li class="nav-item">
          <a href="/dashboard" class="nav-link <%= activeNav === 'dashboard' ? 'active' : '' %>">
            <i class="nav-icon bi bi-speedometer2"></i>
            <p>Dashboard</p>
          </a>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold mt-2" style="font-size: 11px;">Inventario y Artículos</li>
        <li class="nav-item">
          <a href="/equipos" class="nav-link <%= activeNav === 'equipos' ? 'active' : '' %>">
