            <p>Equipos de Red</p>
          </a>
        </li>
        <li class="nav-item">
          <a href="/accesorios" class="nav-link <%= activeNav === 'accesorios' ? 'active' : '' %>">
            <i class="nav-icon bi bi-tools"></i>
            <p>Accesorios / Fibra</p>
          </a>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold mt-2" style="font-size: 11px;">Operaciones y Kardex</li>
        <li class="nav-item">
          <a href="/movimientos/equipos" class="nav-link <%= activeNav === 'mov-equipos' ? 'active' : '' %>">
            <i class="nav-icon bi bi-box-arrow-right"></i>
            <p>Mover Equipos</p>
          </a>
        </li>
        <li class="nav-item">
          <a href="/movimientos/accesorios" class="nav-link <%= activeNav === 'mov-accesorios' ? 'active' : '' %>">
            <i class="nav-icon bi bi-box-arrow-up-right"></i>
            <p>Mover Accesorios</p>
          </a>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold mt-2" style="font-size: 11px;">Gestión Maestra</li>
        <li class="nav-item">
          <a href="/maestros/categorias" class="nav-link <%= activeNav === 'categorias' ? 'active' : '' %>">
            <i class="nav-icon bi bi-folder2-open"></i>
            <p>Categorías</p>
          </a>
        </li>
        <li class="nav-item">
          <a href="/maestros/tipos" class="nav-link <%= activeNav === 'tipos' ? 'active' : '' %>">
            <i class="nav-icon bi bi-tags"></i>
            <p>Tipos de Equipos</p>
          </a>
        </li>
        <li class="nav-item">
          <a href="/maestros/proveedores" class="nav-link <%= activeNav === 'proveedores' ? 'active' : '' %>">
            <i class="nav-icon bi bi-buildings"></i>
            <p>Proveedores (NIT)</p>
          </a>
        </li>
        <li class="nav-item">
          <a href="/maestros/marcas" class="nav-link <%= activeNav === 'marcas' ? 'active' : '' %>">
            <i class="nav-icon bi bi-bookmark-check"></i>
            <p>Marcas</p>
          </a>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold mt-2" style="font-size: 11px;">Control y Taller</li>
        <li class="nav-item">
          <a href="/maestros/mantenimientos" class="nav-link <%= activeNav === 'mantenimientos' ? 'active' : '' %>">
            <i class="nav-icon bi bi-wrench-adjustable"></i>
            <p>Mantenimientos / Taller</p>
          </a>
        </li>
        <li class="nav-item">
          <a href="/maestros/prestamos" class="nav-link <%= activeNav === 'prestamos' ? 'active' : '' %>">
            <i class="nav-icon bi bi-handbag"></i>
            <p>Préstamos</p>
          </a>
        </li>

        <% if (user && user.rol === 'admin') { %>
          <li class="nav-header text-uppercase text-secondary fw-bold mt-2" style="font-size: 11px;">Administración</li>
          <li class="nav-item">
            <a href="/usuarios" class="nav-link <%= activeNav === 'usuarios' ? 'active' : '' %>">
              <i class="nav-icon bi bi-people"></i>
              <p>Usuarios del Sistema</p>
            </a>
          </li>
        <% } %>

      </ul>
    </nav>
  </div>
</aside>
