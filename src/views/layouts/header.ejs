<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Almacén TOI (WMS Pro)</title>
  
  <!-- Tipografía Limpia Clean Industrial & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/mikrowisp-style.css" rel="stylesheet">
</head>
<body>
  <div class="app-wrapper">
    <%- include('sidebar') %>
    
    <div class="main-content">
      <header class="top-navbar">
        <div class="navbar-brand-crumb">
          <button id="sidebarToggle" class="mw-btn mw-btn-outline mw-btn-icon" title="Ocultar/Mostrar Menú (Sidebar)">
            <i class="bi bi-list"></i>
          </button>
          <span><i class="bi bi-boxes text-primary me-1"></i> <%= typeof title !== 'undefined' ? title : 'Almacén TOI' %></span>
        </div>
        
        <div class="top-navbar-actions">
          <!-- Atajo Rápido de Búsqueda WMS UI Pro (Ctrl + K) -->
          <div class="quick-search-box d-none d-md-flex" onclick="focusQuickSearch()" title="Búsqueda rápida en inventario">
            <i class="bi bi-search"></i>
            <span>Buscar en inventario</span>
            <kbd>Ctrl K</kbd>
          </div>

          <div class="d-flex align-items-center gap-2 border-start ps-3">
            <span class="badge-mw badge-neutral">
              <i class="bi bi-person-badge text-primary me-1"></i><%= user ? user.nombre_completo : 'Usuario' %> (<%= user && user.rol ? user.rol.toUpperCase() : 'USER' %>)
            </span>
            <a href="/auth/logout" class="mw-btn mw-btn-outline mw-btn-sm text-danger" title="Cerrar sesión">
              <i class="bi bi-box-arrow-right"></i> Salir
            </a>
          </div>
        </div>
      </header>

      <main class="content-body">
        <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
          <div class="mw-alert <%= flash.type === 'error' ? 'mw-alert-danger' : 'mw-alert-success' %>">
            <i class="bi <%= flash.type === 'error' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill' %>"></i>
            <span><%= flash.message %></span>
          </div>
        <% } %>
