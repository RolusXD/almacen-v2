<!DOCTYPE html>
<html lang="es">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Almacén TOI (AdminLTE 4)</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Google Font: Source Sans 3 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Bootstrap Icons & AdminLTE 4 CSS Oficial -->
  <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/adminlte/css/adminlte.min.css">
  <link rel="stylesheet" href="/css/mikrowisp-style.css">

  <!-- Carga Inmediata de Tema Guardado (Anti-parpadeo) -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('almacen_theme') || 'light';
      if (savedTheme === 'high-contrast') {
        document.documentElement.setAttribute('data-bs-theme', 'dark');
        document.documentElement.classList.add('theme-high-contrast');
      } else {
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
      }
    })();
  </script>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <!-- Navbar Superior Oficial AdminLTE 4 -->
    <nav class="app-header navbar navbar-expand bg-body shadow-sm">
      <div class="container-fluid">
        <!-- Start navbar links -->
        <ul class="navbar-nav align-items-center">
          <li class="nav-item">
            <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" title="Alternar Menú"><i class="bi bi-list fs-5"></i></a>
          </li>
          <li class="nav-item d-none d-md-block ms-2">
            <a href="/dashboard" class="nav-link">Dashboard</a>
          </li>
          <li class="nav-item d-none d-md-block">
            <a href="/equipos" class="nav-link">Equipos</a>
          </li>
          <li class="nav-item d-none d-md-block">
            <a href="/accesorios" class="nav-link">Materiales</a>
          </li>
        </ul>
        <!-- End navbar links -->

        <!-- Right navbar links -->
        <ul class="navbar-nav ms-auto align-items-center">
          <!-- Selector de Temas Oficial AdminLTE 4 (Claro / Noche / Alto Contraste) -->
          <li class="nav-item dropdown me-2">
            <button class="nav-link dropdown-toggle d-flex align-items-center bg-transparent border-0" id="themeDropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cambiar tema de la interfaz">
              <i class="bi bi-circle-half fs-5 me-1" id="currentThemeIcon"></i>
              <span class="d-none d-lg-inline small fw-semibold" id="currentThemeLabel">Tema</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="themeDropdown">
              <li>
                <button type="button" class="dropdown-item d-flex align-items-center gap-2" onclick="setAppTheme('light')">
                  <i class="bi bi-sun-fill text-warning"></i> Modo Claro
                </button>
              </li>
              <li>
                <button type="button" class="dropdown-item d-flex align-items-center gap-2" onclick="setAppTheme('dark')">
                  <i class="bi bi-moon-stars-fill text-primary"></i> Modo Noche
                </button>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <button type="button" class="dropdown-item d-flex align-items-center gap-2" onclick="setAppTheme('high-contrast')">
                  <i class="bi bi-eye-fill text-danger"></i> Alto Contraste
                </button>
              </li>
            </ul>
          </li>

          <!-- Alerta de Stock Bajo -->
          <li class="nav-item me-2">
            <a class="nav-link text-warning d-flex align-items-center" href="/accesorios?stockBajo=1" title="Ver alertas de stock crítico">
              <i class="bi bi-bell-fill fs-5"></i>
              <span class="badge text-bg-danger ms-1" style="font-size: 10px;">Alertas</span>
            </a>
          </li>

          <!-- Menú de Usuario -->
          <li class="nav-item dropdown user-menu">
            <a href="#" class="nav-link dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle fs-5 me-1 text-primary"></i>
              <span class="d-none d-md-inline fw-semibold"><%= user ? user.usuario.toUpperCase() : 'ADMIN' %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end shadow">
              <li class="user-header text-bg-primary text-center p-3">
                <i class="bi bi-person-circle display-6 mb-2"></i>
                <p class="mb-0 fw-bold"><%= user ? user.nombre_completo : 'Administrador Principal' %></p>
                <small class="text-white-50"><%= user ? user.rol : 'Admin' %> • TOI Almacén</small>
              </li>
              <li class="user-footer d-flex justify-content-between p-2 bg-body-tertiary">
                <a href="/dashboard" class="btn btn-outline-secondary btn-sm">Inicio</a>
                <a href="/auth/logout" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión</a>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    </nav>
    <!-- End Navbar -->

    <!-- Sidebar Lateral -->
    <%- include('sidebar') %>

    <!-- Main Content Wrapper -->
    <main class="app-main">
      <div class="app-content-header py-3">
        <div class="container-fluid">
          <div class="row align-items-center">
            <div class="col-sm-6">
              <h4 class="mb-0 fw-bold text-body"><%= typeof title !== 'undefined' ? title : 'Almacén TOI' %></h4>
            </div>
            <div class="col-sm-6">
              <ol class="breadcrumb float-sm-end mb-0">
                <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= typeof title !== 'undefined' ? title : 'Panel' %></li>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <div class="container-fluid">
          <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
            <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
              <div>
                <i class="bi <%= flash.type === 'error' ? 'bi-exclamation-octagon-fill' : 'bi-check-circle-fill' %> me-2"></i>
                <strong><%= flash.type === 'error' ? 'Aviso del Sistema:' : 'Operación Exitosa:' %></strong> <%= flash.message %>
              </div>
              <% if (flash.link) { %>
                <a href="<%= flash.link.url %>" class="btn btn-sm btn-dark shadow-sm" target="_blank">
                  <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> <%= flash.link.text %>
                </a>
              <% } %>
              <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>
