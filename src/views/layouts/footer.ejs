        </div><!-- /.container-fluid -->
      </div><!-- /.app-content -->
    </main><!-- /.app-main -->

    <!-- Footer Oficial AdminLTE 4 -->
    <footer class="app-footer">
      <div class="float-end d-none d-sm-inline">
        <b>Versión</b> 4.0.0 (Node.js & AdminLTE 4)
      </div>
      <strong>Almacén TOI &copy; 2026</strong> Sistema Integrado de Telecomunicaciones.
    </footer>
  </div><!-- /.app-wrapper -->

  <!-- Toast discreto de copiado -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="toastCopy" class="toast align-items-center text-bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          <i class="bi bi-check2-circle text-success me-2"></i>
          <span id="toastCopyText">Copiado al portapapeles</span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <!-- Scripts Oficiales de Bootstrap 5 y AdminLTE 4 -->
  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/adminlte/js/adminlte.min.js"></script>

  <!-- Script de Utilidades WMS -->
  <script>
    function copyToClipboard(text, label) {
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        const toastEl = document.getElementById('toastCopy');
        const textEl = document.getElementById('toastCopyText');
        if (toastEl && textEl) {
          textEl.textContent = (label || 'Texto') + ' copiado: ' + text;
          const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
          toast.show();
        }
      }).catch(err => {
        console.error('Error al copiar:', err);
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      const quickSearch = document.getElementById('quickTableSearch');
      if (quickSearch) {
        quickSearch.addEventListener('input', function () {
          const val = this.value.toLowerCase().trim();
          const rows = document.querySelectorAll('table tbody tr');
          rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(val) ? '' : 'none';
          });
        });
      }
    });
  </script>
</body>
</html>
