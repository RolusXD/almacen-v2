<%- include('../layouts/header', { title: 'Gestión de Equipos', activeNav: 'equipos' }) %>

<div class="erp-box erp-box-blue">
  <div class="erp-box-header">
    <div class="erp-box-title">
      <i class="bi bi-router text-primary"></i> Catálogo e Inventario de Equipos de Red
    </div>
    <div class="d-flex gap-2">
      <a href="/equipos/nuevo" class="btn-erp btn-erp-success">
        <i class="bi bi-plus-lg me-1"></i> + Nuevo Equipo
      </a>
      <a href="/reportes/exportar/equipos" class="btn-erp btn-erp-default" title="Descargar reporte Excel (.xlsx)">
        <i class="bi bi-file-earmark-excel text-success me-1"></i> Exportar (.xlsx)
      </a>
    </div>
  </div>

  <div class="erp-box-body">
    <!-- Toolbar de Filtros y Búsqueda Mikrowisp ERP -->
    <div class="datatables-header-bar mb-3">
      <form method="GET" action="/equipos" class="d-flex flex-wrap align-items-center gap-2">
        <label style="font-size: 11.5px; font-weight: 600; color: #4B646F;">Estado:</label>
        <select name="estado" class="erp-select-sm" onchange="this.form.submit()">
          <option value="Todos" <%= estadoFiltro === 'Todos' ? 'selected' : '' %>>Todos los estados</option>
          <option value="DISPONIBLE" <%= estadoFiltro === 'DISPONIBLE' ? 'selected' : '' %>>DISPONIBLE (En Bodega)</option>
          <option value="OCUPADO" <%= (estadoFiltro === 'OCUPADO' || estadoFiltro === 'ASIGNADO') ? 'selected' : '' %>>OCUPADO / ASIGNADO</option>
          <option value="MANTENIMIENTO" <%= estadoFiltro === 'MANTENIMIENTO' ? 'selected' : '' %>>MANTENIMIENTO / TALLER</option>
          <option value="RETIRADO" <%= estadoFiltro === 'RETIRADO' ? 'selected' : '' %>>RETIRADO (De Baja)</option>
        </select>

        <label style="font-size: 11.5px; font-weight: 600; color: #4B646F;">Código / Tipo:</label>
        <select name="codigo" class="erp-select-sm" onchange="this.form.submit()">
          <option value="Todos">Todos los códigos</option>
          <% tipos.forEach(t => { %>
            <option value="<%= t.codigo %>" <%= codigoFiltro === t.codigo ? 'selected' : '' %>>
              <%= t.codigo %> - <%= t.descripcion %>
            </option>
          <% }); %>
        </select>

        <div class="d-flex align-items-center gap-1">
          <input type="text" name="filtro" class="erp-input-sm font-mono" placeholder="Buscar serie, modelo, marca..." value="<%= filtro || '' %>" style="min-width: 220px;">
          <button type="submit" class="btn-erp btn-erp-primary btn-sm" title="Ejecutar búsqueda"><i class="bi bi-search"></i></button>
          <% if (filtro || (estadoFiltro && estadoFiltro !== 'Todos') || (codigoFiltro && codigoFiltro !== 'Todos')) { %>
            <a href="/equipos" class="btn-erp btn-erp-default btn-sm" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>

      <div class="datatables-length-select">
        Mostrando <strong class="font-tabular"><%= equipos.length %></strong> equipo(s)
      </div>
    </div>

    <!-- Tabla de Alta Densidad con Encabezados Fijos -->
    <div class="table-responsive-erp">
      <table class="table-erp">
        <thead>
          <tr>
            <th style="width: 50px;">ID</th>
            <th>PRODUCTO / NOMBRE</th>
            <th>CÓDIGO</th>
            <th>N° SERIE / MAC</th>
            <th>MODELO</th>
            <th>MARCA</th>
            <th class="col-number">PRECIO (Bs.)</th>
            <th>CALIDAD</th>
            <th>ESTADO</th>
            <th class="actions-cell">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          <% if (equipos && equipos.length > 0) { %>
            <% equipos.forEach(eq => { %>
              <tr>
                <td class="col-number"><small class="text-muted">#<%= eq.id_equipo %></small></td>
                <td><strong><%= eq.nombre %></strong></td>
                <td>
                  <span class="badge-erp badge-erp-primary"><%= eq.codigo || '-' %></span>
                </td>
                <td>
                  <span class="font-mono text-primary" style="font-weight: 600;">
                    <%= eq.numero_serie_mac %>
                    <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= eq.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                      <i class="bi bi-clipboard"></i>
                    </button>
                  </span>
                </td>
                <td><%= eq.modelo || '-' %></td>
                <td><%= eq.marca || '-' %></td>
                <td class="col-number font-tabular">
                  Bs. <%= Number(eq.precio || 0).toFixed(2) %>
                </td>
                <td>
                  <span class="badge-erp badge-erp-info">NUEVO</span>
                </td>
                <td>
                  <% if (eq.estado === 'DISPONIBLE') { %>
                    <span class="badge-erp badge-erp-success">DISPONIBLE</span>
                  <% } else if (eq.estado === 'OCUPADO' || eq.estado === 'ASIGNADO' || eq.estado === 'SALIDA') { %>
                    <span class="badge-erp badge-erp-danger">OCUPADO</span>
                  <% } else if (eq.estado === 'MANTENIMIENTO' || eq.estado === 'REVISION') { %>
                    <span class="badge-erp badge-erp-warning">TALLER</span>
                  <% } else { %>
                    <span class="badge-erp badge-erp-purple"><%= eq.estado %></span>
                  <% } %>
                </td>
                <td class="actions-cell">
                  <a href="/movimientos/equipos?filtro=<%= encodeURIComponent(eq.numero_serie_mac) %>" class="btn-erp btn-erp-default btn-sm" title="Registrar movimiento o ver kardex">
                    <i class="bi bi-arrow-left-right text-primary"></i>
                  </a>
                  <a href="/equipos/editar/<%= eq.id_equipo %>" class="btn-erp btn-erp-default btn-sm" title="Editar ficha">
                    <i class="bi bi-pencil-square text-secondary"></i>
                  </a>
                  <a href="/equipos/eliminar/<%= eq.id_equipo %>" class="btn-erp btn-erp-danger btn-sm" title="Eliminar equipo" onclick="return confirm('¿Seguro que desea eliminar el equipo <%= eq.numero_serie_mac %>?');">
                    <i class="bi bi-trash"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                No se encontraron equipos que coincidan con los filtros aplicados.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
