<%- include('../layouts/header', { title: 'Gestión de Equipos', activeNav: 'equipos' }) %>

<div class="mw-card">
  <div class="mw-card-header">
    <div class="mw-card-title">
      <i class="bi bi-router text-primary"></i> Inventario de Equipos de Red
    </div>
    <div class="d-flex gap-2">
      <a href="/equipos/nuevo" class="mw-btn mw-btn-success">
        <i class="bi bi-plus-lg"></i> + Nuevo Equipo
      </a>
      <a href="/reportes/exportar/equipos" class="mw-btn mw-btn-outline mw-btn-sm" title="Descargar Excel">
        <i class="bi bi-file-earmark-excel text-success"></i> Exportar
      </a>
    </div>
  </div>

  <div class="mw-card-body">
    <!-- Toolbar de Filtros y Búsqueda -->
    <div class="mw-toolbar">
      <form method="GET" action="/equipos" class="mw-toolbar-group">
        <label class="text-muted" style="font-size: 11.5px;">Estado:</label>
        <select name="estado" class="mw-select" onchange="this.form.submit()">
          <option value="Todos" <%= estadoFiltro === 'Todos' ? 'selected' : '' %>>Todos los estados</option>
          <option value="DISPONIBLE" <%= estadoFiltro === 'DISPONIBLE' ? 'selected' : '' %>>DISPONIBLE</option>
          <option value="ASIGNADO" <%= estadoFiltro === 'ASIGNADO' ? 'selected' : '' %>>ASIGNADO</option>
          <option value="MANTENIMIENTO" <%= estadoFiltro === 'MANTENIMIENTO' ? 'selected' : '' %>>MANTENIMIENTO</option>
          <option value="REVISION" <%= estadoFiltro === 'REVISION' ? 'selected' : '' %>>REVISION</option>
        </select>

        <label class="text-muted" style="font-size: 11.5px;">Código:</label>
        <select name="codigo" class="mw-select" onchange="this.form.submit()">
          <option value="Todos">Todos los códigos</option>
          <% tipos.forEach(t => { %>
            <option value="<%= t.codigo %>" <%= codigoFiltro === t.codigo ? 'selected' : '' %>>
              <%= t.codigo %> - <%= t.descripcion %>
            </option>
          <% }); %>
        </select>

        <div class="d-flex align-items-center gap-1">
          <input type="text" name="filtro" class="mw-input" placeholder="Buscar serie, modelo, marca..." value="<%= filtro || '' %>" style="min-width: 220px;">
          <button type="submit" class="mw-btn mw-btn-primary mw-btn-sm"><i class="bi bi-search"></i></button>
          <% if (filtro || (estadoFiltro && estadoFiltro !== 'Todos') || (codigoFiltro && codigoFiltro !== 'Todos')) { %>
            <a href="/equipos" class="mw-btn mw-btn-outline mw-btn-sm" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>

      <div class="text-muted" style="font-size: 11.5px;">
        Mostrando <strong><%= equipos.length %></strong> equipo(s)
      </div>
    </div>

    <!-- Tabla Compacta de Alta Densidad -->
    <div class="mw-table-container">
      <table class="mw-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>PRODUCTO / NOMBRE</th>
            <th>CÓDIGO</th>
            <th>N° SERIE / MAC</th>
            <th>MODELO</th>
            <th>MARCA</th>
            <th>PRECIO (Bs.)</th>
            <th>CALIDAD</th>
            <th>ESTADO</th>
            <th class="actions-cell">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          <% if (equipos && equipos.length > 0) { %>
            <% equipos.forEach(eq => { %>
              <tr>
                <td><small class="text-muted">#<%= eq.id_equipo %></small></td>
                <td><strong><%= eq.nombre %></strong></td>
                <td><span class="badge-mw badge-neutral"><%= eq.codigo || '-' %></span></td>
                <td><span class="badge-mw badge-disponible" style="font-family: monospace; font-size: 12px;"><%= eq.numero_serie_mac %></span></td>
                <td><%= eq.modelo || '-' %></td>
                <td><%= eq.marca || '-' %></td>
                <td>Bs. <%= Number(eq.precio || 0).toFixed(2) %></td>
                <td><span class="badge-mw badge-neutral text-primary">NUEVO</span></td>
                <td>
                  <% if (eq.estado === 'DISPONIBLE') { %>
                    <span class="badge-mw badge-disponible">DISPONIBLE</span>
                  <% } else if (eq.estado === 'ASIGNADO' || eq.estado === 'SALIDA') { %>
                    <span class="badge-mw badge-asignado">ASIGNADO</span>
                  <% } else { %>
                    <span class="badge-mw badge-mantenimiento"><%= eq.estado %></span>
                  <% } %>
                </td>
                <td class="actions-cell">
                  <a href="/equipos/editar/<%= eq.id_equipo %>" class="mw-btn mw-btn-outline mw-btn-sm mw-btn-icon" title="Editar">
                    <i class="bi bi-pencil-square text-primary"></i>
                  </a>
                  <a href="/movimientos/equipos?filtro=<%= encodeURIComponent(eq.numero_serie_mac) %>" class="mw-btn mw-btn-outline mw-btn-sm mw-btn-icon" title="Historial de movimientos">
                    <i class="bi bi-clock-history text-secondary"></i>
                  </a>
                  <a href="/equipos/eliminar/<%= eq.id_equipo %>" class="mw-btn mw-btn-outline mw-btn-sm mw-btn-icon" title="Eliminar" onclick="return confirm('¿Seguro que desea eliminar el equipo <%= eq.numero_serie_mac %>?');">
                    <i class="bi bi-trash text-danger"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center text-muted py-4">
                <i class="bi bi-inbox" style="font-size: 1.5rem; display: block; margin-bottom: 0.35rem;"></i>
                No se encontraron equipos registrados con los criterios seleccionados.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
