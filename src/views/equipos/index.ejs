<%- include('../layouts/header', { title: 'Gestión de Equipos', activeNav: 'equipos' }) %>

<div class="mw-card">
  <div class="mw-card-header">
    <div class="mw-card-title">
      <i class="bi bi-router text-primary"></i> Catálogo e Inventario de Equipos de Red
    </div>
    <div class="d-flex gap-2">
      <a href="/equipos/nuevo" class="mw-btn mw-btn-primary mw-btn-touch">
        <i class="bi bi-plus-lg"></i> + Nuevo Equipo (NUEVO)
      </a>
      <a href="/reportes/exportar/equipos" class="mw-btn mw-btn-outline mw-btn-touch" title="Descargar reporte Excel (.xlsx)">
        <i class="bi bi-file-earmark-excel text-success"></i> Exportar (.xlsx)
      </a>
    </div>
  </div>

  <div class="mw-card-body">
    <!-- Toolbar de Filtros y Búsqueda WMS UI PRO -->
    <div class="mw-toolbar">
      <form method="GET" action="/equipos" class="mw-toolbar-group">
        <label class="text-muted" style="font-size: 11.5px; font-weight: 600;">Estado:</label>
        <select name="estado" class="mw-select" onchange="this.form.submit()">
          <option value="Todos" <%= estadoFiltro === 'Todos' ? 'selected' : '' %>>Todos los estados</option>
          <option value="DISPONIBLE" <%= estadoFiltro === 'DISPONIBLE' ? 'selected' : '' %>>DISPONIBLE (En Bodega)</option>
          <option value="OCUPADO" <%= (estadoFiltro === 'OCUPADO' || estadoFiltro === 'ASIGNADO') ? 'selected' : '' %>>OCUPADO / ASIGNADO</option>
          <option value="MANTENIMIENTO" <%= estadoFiltro === 'MANTENIMIENTO' ? 'selected' : '' %>>MANTENIMIENTO / TALLER</option>
          <option value="RETIRADO" <%= estadoFiltro === 'RETIRADO' ? 'selected' : '' %>>RETIRADO (De Baja)</option>
        </select>

        <label class="text-muted" style="font-size: 11.5px; font-weight: 600;">Código / Tipo:</label>
        <select name="codigo" class="mw-select" onchange="this.form.submit()">
          <option value="Todos">Todos los códigos</option>
          <% tipos.forEach(t => { %>
            <option value="<%= t.codigo %>" <%= codigoFiltro === t.codigo ? 'selected' : '' %>>
              <%= t.codigo %> - <%= t.descripcion %>
            </option>
          <% }); %>
        </select>

        <div class="d-flex align-items-center gap-1">
          <input type="text" name="filtro" class="mw-input font-mono" placeholder="Buscar serie, modelo, marca..." value="<%= filtro || '' %>" style="min-width: 220px;">
          <button type="submit" class="mw-btn mw-btn-primary mw-btn-sm" title="Ejecutar búsqueda"><i class="bi bi-search"></i></button>
          <% if (filtro || (estadoFiltro && estadoFiltro !== 'Todos') || (codigoFiltro && codigoFiltro !== 'Todos')) { %>
            <a href="/equipos" class="mw-btn mw-btn-outline mw-btn-sm" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>

      <div class="text-muted" style="font-size: 11.5px;">
        Mostrando <strong class="text-dark font-tabular"><%= equipos.length %></strong> equipo(s)
      </div>
    </div>

    <!-- Tabla de Alta Densidad con Encabezados Fijos (Sticky) -->
    <div class="mw-table-container">
      <table class="mw-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>PRODUCTO / NOMBRE</th>
            <th>CÓDIGO</th>
            <th>N° SERIE / MAC</th>
            <th>MODELO</th>
            <th>MARCA</th>
            <th class="col-number">PRECIO (Bs.)</th>
            <th>CALIDAD</th>
            <th>ESTADO</th>
            <th class="actions-cell">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          <% if (equipos && equipos.length > 0) { %>
            <% equipos.forEach(eq => { %>
              <tr>
                <td class="font-tabular"><small class="text-muted">#<%= eq.id_equipo %></small></td>
                <td><strong><%= eq.nombre %></strong></td>
                <td>
                  <span class="badge-mw badge-neutral"><%= eq.codigo || '-' %></span>
                </td>
                <td>
                  <span class="font-mono">
                    <%= eq.numero_serie_mac %>
                    <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= eq.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                      <i class="bi bi-clipboard"></i>
                    </button>
                  </span>
                </td>
                <td><%= eq.modelo || '-' %></td>
                <td><%= eq.marca || '-' %></td>
                <td class="col-number font-tabular">
                  Bs. <%= Number(eq.precio || 0).toFixed(2) %>
                </td>
                <td>
                  <span class="badge-mw badge-neutral text-primary" style="font-size: 10px;">NUEVO</span>
                </td>
                <td>
                  <% if (eq.estado === 'DISPONIBLE') { %>
                    <span class="badge-mw badge-wms-optimo">DISPONIBLE</span>
                  <% } else if (eq.estado === 'OCUPADO' || eq.estado === 'ASIGNADO' || eq.estado === 'SALIDA') { %>
                    <span class="badge-mw badge-wms-critico">OCUPADO</span>
                  <% } else if (eq.estado === 'MANTENIMIENTO' || eq.estado === 'REVISION') { %>
                    <span class="badge-mw badge-wms-transito">TALLER</span>
                  <% } else { %>
                    <span class="badge-mw badge-neutral"><%= eq.estado %></span>
                  <% } %>
                </td>
                <td class="actions-cell">
                  <a href="/movimientos/equipos?filtro=<%= encodeURIComponent(eq.numero_serie_mac) %>" class="mw-btn mw-btn-outline mw-btn-sm mw-btn-icon" title="Registrar movimiento o ver kardex">
                    <i class="bi bi-arrow-left-right text-primary"></i>
                  </a>
                  <a href="/equipos/editar/<%= eq.id_equipo %>" class="mw-btn mw-btn-outline mw-btn-sm mw-btn-icon" title="Editar ficha">
                    <i class="bi bi-pencil-square text-secondary"></i>
                  </a>
                  <a href="/equipos/eliminar/<%= eq.id_equipo %>" class="mw-btn mw-btn-danger-outline mw-btn-sm mw-btn-icon" title="Eliminar equipo" onclick="return confirm('¿Seguro que desea eliminar el equipo <%= eq.numero_serie_mac %>?');">
                    <i class="bi bi-trash"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                No se encontraron equipos que coincidan con los filtros aplicados.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
