<%- include('../layouts/header', { title: 'Gestión de Equipos', activeNav: 'equipos' }) %>

<div class="card card-primary card-outline shadow-sm mb-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h3 class="card-title">
      <i class="bi bi-router text-primary me-2"></i> Catálogo e Inventario de Equipos de Red
    </h3>
    <div class="card-tools d-flex gap-2 ms-auto">
      <a href="/equipos/nuevo" class="btn btn-success btn-sm">
        <i class="bi bi-plus-lg me-1"></i> + Nuevo Equipo
      </a>
      <a href="/reportes/exportar/equipos" class="btn btn-outline-secondary btn-sm" title="Descargar reporte Excel (.xlsx)">
        <i class="bi bi-file-earmark-excel text-success me-1"></i> Exportar (.xlsx)
      </a>
    </div>
  </div>

  <div class="card-body">
    <!-- Toolbar de Filtros y Búsqueda AdminLTE 4 / Bootstrap 5 -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 bg-light p-2 rounded border">
      <form method="GET" action="/equipos" class="d-flex flex-wrap align-items-center gap-2">
        <label class="form-label mb-0 small fw-bold text-secondary">Estado:</label>
        <select name="estado" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
          <option value="Todos" <%= estadoFiltro === 'Todos' ? 'selected' : '' %>>Todos los estados</option>
          <option value="DISPONIBLE" <%= estadoFiltro === 'DISPONIBLE' ? 'selected' : '' %>>DISPONIBLE (En Bodega)</option>
          <option value="OCUPADO" <%= (estadoFiltro === 'OCUPADO' || estadoFiltro === 'ASIGNADO') ? 'selected' : '' %>>OCUPADO / ASIGNADO</option>
          <option value="MANTENIMIENTO" <%= estadoFiltro === 'MANTENIMIENTO' ? 'selected' : '' %>>MANTENIMIENTO / TALLER</option>
          <option value="RETIRADO" <%= estadoFiltro === 'RETIRADO' ? 'selected' : '' %>>RETIRADO (De Baja)</option>
        </select>

        <label class="form-label mb-0 small fw-bold text-secondary">Código / Tipo:</label>
        <select name="codigo" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
          <option value="Todos">Todos los códigos</option>
          <% tipos.forEach(t => { %>
            <option value="<%= t.codigo %>" <%= codigoFiltro === t.codigo ? 'selected' : '' %>>
              <%= t.codigo %> - <%= t.descripcion %>
            </option>
          <% }); %>
        </select>

        <div class="d-flex align-items-center gap-1">
          <input type="text" name="filtro" class="form-control form-control-sm font-mono" placeholder="Buscar serie, modelo..." value="<%= filtro || '' %>" style="min-width: 220px;">
          <button type="submit" class="btn btn-primary btn-sm" title="Ejecutar búsqueda"><i class="bi bi-search"></i></button>
          <% if (filtro || (estadoFiltro && estadoFiltro !== 'Todos') || (codigoFiltro && codigoFiltro !== 'Todos')) { %>
            <a href="/equipos" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>

      <div class="small text-muted ms-auto">
        Mostrando <strong class="text-dark font-tabular"><%= equipos.length %></strong> equipo(s)
      </div>
    </div>

    <!-- Tabla Oficial AdminLTE 4 / Bootstrap 5 -->
    <div class="table-responsive">
      <table class="table table-bordered table-striped table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 60px;">ID</th>
            <th>PRODUCTO / NOMBRE</th>
            <th>CÓDIGO</th>
            <th>N° SERIE / MAC</th>
            <th>MODELO</th>
            <th>MARCA</th>
            <th class="text-end">PRECIO (Bs.)</th>
            <th>CALIDAD</th>
            <th>ESTADO</th>
            <th class="text-end">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          <% if (equipos && equipos.length > 0) { %>
            <% equipos.forEach(eq => { %>
              <tr>
                <td class="text-muted font-tabular small">#<%= eq.id_equipo %></td>
                <td><strong><%= eq.nombre %></strong></td>
                <td>
                  <span class="badge text-bg-primary"><%= eq.codigo || '-' %></span>
                </td>
                <td>
                  <span class="font-mono text-primary fw-semibold">
                    <%= eq.numero_serie_mac %>
                    <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= eq.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                      <i class="bi bi-clipboard"></i>
                    </button>
                  </span>
                </td>
                <td><%= eq.modelo || '-' %></td>
                <td><%= eq.marca || '-' %></td>
                <td class="text-end font-tabular">
                  Bs. <%= Number(eq.precio || 0).toFixed(2) %>
                </td>
                <td>
                  <span class="badge text-bg-info">NUEVO</span>
                </td>
                <td>
                  <% if (eq.estado === 'DISPONIBLE') { %>
                    <span class="badge text-bg-success">DISPONIBLE</span>
                  <% } else if (eq.estado === 'OCUPADO' || eq.estado === 'ASIGNADO' || eq.estado === 'SALIDA') { %>
                    <span class="badge text-bg-danger">OCUPADO</span>
                  <% } else if (eq.estado === 'MANTENIMIENTO' || eq.estado === 'REVISION') { %>
                    <span class="badge text-bg-warning">TALLER</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary"><%= eq.estado %></span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/movimientos/equipos?filtro=<%= encodeURIComponent(eq.numero_serie_mac) %>" class="btn btn-outline-primary" title="Registrar movimiento o ver kardex">
                      <i class="bi bi-arrow-left-right"></i>
                    </a>
                    <a href="/equipos/editar/<%= eq.id_equipo %>" class="btn btn-outline-secondary" title="Editar ficha">
                      <i class="bi bi-pencil-square"></i>
                    </a>
                    <a href="/equipos/eliminar/<%= eq.id_equipo %>" class="btn btn-outline-danger" title="Eliminar equipo" onclick="return confirm('¿Seguro que desea eliminar el equipo <%= eq.numero_serie_mac %>?');">
                      <i class="bi bi-trash"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                No se encontraron equipos que coincidan con los filtros aplicados.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
