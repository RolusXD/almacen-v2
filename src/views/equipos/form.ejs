<%- include('../layouts/header', { title: equipo ? 'Editar Equipo' : 'Nuevo Equipo', activeNav: 'equipos' }) %>

<div class="row justify-content-center">
  <div class="col-12 col-xl-10">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">
          <i class="bi <%= equipo ? 'bi-pencil-square text-primary' : 'bi-plus-circle text-success' %> me-2"></i>
          <span><%= equipo ? 'Editar Ficha de Equipo: ' + equipo.numero_serie_mac : 'Registro de Nuevo Equipo de Red' %></span>
        </h3>
        <div class="card-tools ms-auto">
          <a href="/equipos" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver a Equipos
          </a>
        </div>
      </div>

      <div class="card-body">
        <form method="POST" action="<%= equipo ? '/equipos/editar/' + equipo.id_equipo : '/equipos/nuevo' %>">
          
          <!-- SECCIÓN 1: IDENTIFICACIÓN -->
          <div class="p-2 bg-body-tertiary border-start border-primary border-3 mb-3 rounded">
            <span class="fw-bold text-body small text-uppercase">
              <i class="bi bi-upc-scan me-1 text-primary"></i> 1. Identificación del Equipo
            </span>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">N° DE SERIE O MAC <span class="text-danger">*</span></label>
              <input type="text" name="numero_serie_mac" class="form-control font-mono" placeholder="Ej: 445121884JXX o F4:8E:38:XX:XX" value="<%= equipo ? equipo.numero_serie_mac : '' %>" required <%= equipo ? 'readonly style="background-color: #f8f9fa;"' : 'autofocus' %>>
              <div class="form-text">Identificador único físico del equipo.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">DESCRIPCIÓN / NOMBRE <span class="text-danger">*</span></label>
              <input type="text" name="nombre" class="form-control" placeholder="Ej: ROUTER DUAL BAND o ONT GPON" value="<%= equipo ? equipo.nombre : '' %>" required>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">TIPO DE EQUIPO (CÓDIGO)</label>
              <select name="codigo" id="select_codigo" class="form-select">
                <option value="">Seleccione tipo...</option>
                <% tipos.forEach(t => { %>
                  <option value="<%= t.codigo %>" <%= equipo && equipo.codigo === t.codigo ? 'selected' : '' %>>
                    <%= t.codigo %> - <%= t.descripcion %> (<%= t.categoria %>)
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">CALIDAD (ESTADO DE INGRESO)</label>
              <input type="text" class="form-control" value="NUEVO" readonly style="background-color: #e9ecef; font-weight: 700; color: #0d6efd; cursor: not-allowed;">
              <input type="hidden" name="calidad" value="NUEVO">
              <div class="form-text">Restringido por norma de almacén: todo registro entra como NUEVO.</div>
            </div>
          </div>

          <!-- SECCIÓN 2: CARACTERÍSTICAS TÉCNICAS -->
          <div class="p-2 bg-body-tertiary border-start border-info border-3 mt-4 mb-3 rounded">
            <span class="fw-bold text-body small text-uppercase">
              <i class="bi bi-cpu me-1 text-info"></i> 2. Características Técnicas
            </span>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">MODELO</label>
              <input type="text" name="modelo" id="input_modelo" list="modelos_list" class="form-control" placeholder="Ej: WR940N, V2802GW" value="<%= equipo ? equipo.modelo : '' %>">
              <datalist id="modelos_list">
                <% modelosRef.forEach(m => { %>
                  <option value="<%= m.modelo %>"><%= m.marca %> - <%= m.nombre %></option>
                <% }); %>
              </datalist>
              <div class="form-text">Escriba para autocompletar modelos ya registrados.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">MARCA</label>
              <input type="text" name="marca" id="input_marca" class="form-control" placeholder="Ej: TP-LINK, HUAWEI, VSOL, MIKROTIK" value="<%= equipo ? equipo.marca : '' %>">
            </div>
          </div>

          <!-- SECCIÓN 3: INFORMACIÓN COMERCIAL -->
          <div class="p-2 bg-body-tertiary border-start border-success border-3 mt-4 mb-3 rounded">
            <span class="fw-bold text-body small text-uppercase">
              <i class="bi bi-currency-dollar me-1 text-success"></i> 3. Información Comercial y Origen
            </span>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">PRECIO UNITARIO (Bs.)</label>
              <input type="number" step="0.01" name="precio" class="form-control font-tabular text-end" placeholder="0.00" value="<%= equipo ? equipo.precio : '0.00' %>">
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">PROVEEDOR</label>
              <input type="text" name="proveedor" class="form-control" placeholder="Ej: DIGICORP, COMRADE" value="<%= equipo ? equipo.proveedor : '' %>">
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">FECHA DE INGRESO</label>
              <input type="date" name="fecha_entrada" class="form-control font-tabular" value="<%= equipo && equipo.fecha_entrada ? new Date(equipo.fecha_entrada).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>">
            </div>
          </div>

          <!-- SECCIÓN 4: OBSERVACIONES -->
          <div class="p-2 bg-body-tertiary border-start border-warning border-3 mt-4 mb-3 rounded">
            <span class="fw-bold text-body small text-uppercase">
              <i class="bi bi-chat-left-text me-1 text-warning"></i> 4. Observaciones y Notas
            </span>
          </div>

          <div class="mb-4">
            <textarea name="observaciones" rows="3" class="form-control" placeholder="Notas sobre el lote, estado de empaque, destino previsto..."><%= equipo ? equipo.observaciones : '' %></textarea>
          </div>

          <div class="d-flex align-items-center gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-success px-4">
              <i class="bi bi-save me-1"></i> <%= equipo ? 'Guardar Cambios' : 'Registrar Equipo' %>
            </button>
            <a href="/equipos" class="btn btn-outline-secondary px-3">
              Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
