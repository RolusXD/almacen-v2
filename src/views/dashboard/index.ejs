<%- include('../layouts/header', { title: 'Dashboard Operativo', activeNav: 'dashboard' }) %>

<!-- Dashboard Operativo WMS UI PRO: Exactamente 4 Tarjetas KPI -->
<div class="dashboard-kpi-grid">
  <!-- KPI 1: Total Equipos -->
  <div class="dashboard-kpi-card kpi-optimal">
    <div>
      <div class="kpi-label">Equipos Registrados</div>
      <div class="kpi-number"><%= statsEquipos.total %></div>
      <div class="kpi-subtext">
        <span class="badge-mw badge-wms-optimo" style="padding: 1px 5px;"><%= statsEquipos.disponibles %> disp.</span>
        <span>•</span>
        <span class="badge-mw badge-wms-critico" style="padding: 1px 5px;"><%= statsEquipos.asignados %> ocupados</span>
      </div>
    </div>
    <div class="kpi-icon-wrap" style="background: #DCFCE7; color: #166534;">
      <i class="bi bi-router"></i>
    </div>
  </div>

  <!-- KPI 2: Stock Crítico (< 10) con enlace directo filtrado -->
  <a href="/accesorios?stock_bajo=true" class="dashboard-kpi-card kpi-critical text-decoration-none" title="Ver accesorios con stock bajo">
    <div>
      <div class="kpi-label">Stock Crítico Materiales</div>
      <div class="kpi-number" style="color: <%= statsAccesorios.stockBajo > 0 ? '#991B1B' : '#166534' %>;">
        <%= statsAccesorios.stockBajo %>
      </div>
      <div class="kpi-subtext" style="color: <%= statsAccesorios.stockBajo > 0 ? '#991B1B' : '#64748B' %>;">
        <i class="bi <%= statsAccesorios.stockBajo > 0 ? 'bi-exclamation-triangle-fill text-danger' : 'bi-check-circle-fill text-success' %>"></i>
        <span><%= statsAccesorios.stockBajo > 0 ? 'Requieren reabastecimiento' : 'Stock bajo control' %></span>
      </div>
    </div>
    <div class="kpi-icon-wrap" style="background: <%= statsAccesorios.stockBajo > 0 ? '#FEE2E2' : '#F1F5F9' %>; color: <%= statsAccesorios.stockBajo > 0 ? '#991B1B' : '#64748B' %>;">
      <i class="bi bi-shield-exclamation"></i>
    </div>
  </a>

  <!-- KPI 3: Equipos en Taller / Mantenimiento -->
  <a href="/maestros/mantenimientos" class="dashboard-kpi-card kpi-maintenance text-decoration-none" title="Ir a control de mantenimientos">
    <div>
      <div class="kpi-label">Equipos en Taller</div>
      <div class="kpi-number" style="color: <%= statsEquipos.mantenimiento > 0 ? '#075985' : '#0F172A' %>;">
        <%= statsEquipos.mantenimiento %>
      </div>
      <div class="kpi-subtext">
        <i class="bi bi-wrench-adjustable text-primary"></i>
        <span>En revisión o reparación</span>
      </div>
    </div>
    <div class="kpi-icon-wrap" style="background: #E0F2FE; color: #075985;">
      <i class="bi bi-tools"></i>
    </div>
  </a>

  <!-- KPI 4: Accesorios y Materiales -->
  <a href="/accesorios" class="dashboard-kpi-card kpi-movement text-decoration-none" title="Ver catálogo de accesorios">
    <div>
      <div class="kpi-label">Total Materiales</div>
      <div class="kpi-number"><%= statsAccesorios.totalUnidades %></div>
      <div class="kpi-subtext">
        <i class="bi bi-layers text-secondary"></i>
        <span><%= statsAccesorios.totalItems %> categorías en bodega</span>
      </div>
    </div>
    <div class="kpi-icon-wrap" style="background: #F1F5F9; color: #0F172A;">
      <i class="bi bi-boxes"></i>
    </div>
  </a>
</div>

<!-- Accesos Rápidos Operativos -->
<div class="mw-card">
  <div class="mw-card-header">
    <span class="mw-card-title"><i class="bi bi-lightning-charge text-warning"></i> Operaciones Inmediatas de Almacén</span>
  </div>
  <div class="mw-card-body d-flex gap-2 flex-wrap">
    <a href="/movimientos/equipos" class="mw-btn mw-btn-primary mw-btn-touch">
      <i class="bi bi-arrow-left-right"></i> Registrar Movimiento de Equipos
    </a>
    <a href="/movimientos/accesorios" class="mw-btn mw-btn-primary mw-btn-touch">
      <i class="bi bi-box-arrow-up-right"></i> Despachar Accesorios con Destino
    </a>
    <a href="/equipos/nuevo" class="mw-btn mw-btn-outline mw-btn-touch">
      <i class="bi bi-plus-circle text-primary"></i> Alta de Equipo (NUEVO)
    </a>
    <a href="/accesorios/nuevo" class="mw-btn mw-btn-outline mw-btn-touch">
      <i class="bi bi-plus-circle text-primary"></i> Alta de Material
    </a>
    <a href="/reportes/exportar/equipos" class="mw-btn mw-btn-outline mw-btn-touch ms-auto">
      <i class="bi bi-file-earmark-excel text-success"></i> Exportar Equipos
    </a>
  </div>
</div>

<!-- Tabla de Últimos Movimientos con Formato WMS UI Pro -->
<div class="mw-card">
  <div class="mw-card-header">
    <span class="mw-card-title">
      <i class="bi bi-clock-history text-primary"></i> Últimos Movimientos Operativos
    </span>
    <div class="d-flex align-items-center gap-2">
      <input type="text" id="quickTableSearch" class="mw-input" placeholder="Filtrar por serie, equipo, destino..." style="width: 240px;">
      <a href="/movimientos/equipos" class="mw-btn mw-btn-outline mw-btn-sm">Ver Todos</a>
    </div>
  </div>

  <div class="mw-table-container">
    <table class="mw-table">
      <thead>
        <tr>
          <th>FECHA</th>
          <th>TIPO</th>
          <th>N° SERIE / MAC</th>
          <th>EQUIPO / MODELO</th>
          <th>DESTINO</th>
          <th>ENCARGADO</th>
          <th>ASUNTO</th>
          <th class="actions-cell">ACCIONES</th>
        </tr>
      </thead>
      <tbody>
        <% if (ultimosMovimientos && ultimosMovimientos.length > 0) { %>
          <% ultimosMovimientos.forEach(m => { %>
            <tr>
              <td class="col-fecha font-tabular">
                <%= m.fecha_movimiento ? new Date(m.fecha_movimiento).toISOString().split('T')[0] : '-' %>
              </td>
              <td>
                <% if (m.tipo_movimiento === 'SALIDA') { %>
                  <span class="badge-mw badge-wms-critico">SALIDA</span>
                <% } else if (m.tipo_movimiento === 'ENTRADA') { %>
                  <span class="badge-mw badge-wms-optimo">ENTRADA</span>
                <% } else { %>
                  <span class="badge-mw badge-wms-transito"><%= m.tipo_movimiento %></span>
                <% } %>
              </td>
              <td>
                <span class="font-mono">
                  <%= m.numero_serie_mac %>
                  <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= m.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                    <i class="bi bi-clipboard"></i>
                  </button>
                </span>
              </td>
              <td>
                <strong><%= m.nombre_equipo || 'Equipo' %></strong>
                <% if (m.modelo_equipo) { %>
                  <span class="text-muted ms-1">(<%= m.modelo_equipo %>)</span>
                <% } %>
              </td>
              <td>
                <% if (m.destino) { %>
                  <span class="badge-mw badge-neutral"><i class="bi bi-geo-alt me-1 text-primary"></i><%= m.destino %></span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td><%= m.encargado || '-' %></td>
              <td class="text-truncate" style="max-width: 220px;" title="<%= m.asunto %>">
                <%= m.asunto || '-' %>
              </td>
              <td class="actions-cell">
                <a href="/movimientos/equipos" class="mw-btn mw-btn-outline mw-btn-sm" title="Ver kardex">
                  <i class="bi bi-eye"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              <i class="bi bi-inbox fs-4 d-block mb-2"></i>
              No se registran movimientos recientes en el sistema.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>
