<%- include('../layouts/header', { title: 'Dashboard General', activeNav: 'dashboard' }) %>

<!-- 4 TARJETAS KPI SUPERIORES (ESTILO MIKROWISP / ADMINLTE - COLORES SÓLIDOS VIBRANTES) -->
<div class="kpi-row-mikrowisp">
  
  <!-- KPI 1: Teal (#00A65A) - Stock y Equipos Disponibles -->
  <div class="kpi-box kpi-teal">
    <div class="kpi-box-inner">
      <div class="kpi-box-number"><%= statsEquipos.disponibles %></div>
      <div class="kpi-box-title">Equipos Disponibles</div>
      <div class="kpi-box-sub">
        Total en almacén: <strong><%= statsEquipos.total %></strong> equipos
      </div>
      <i class="bi bi-router kpi-box-icon"></i>
    </div>
    <a href="/equipos?estado=DISPONIBLE" class="kpi-box-footer">
      <span>Ver detalle de disponibles</span>
      <i class="bi bi-arrow-right-circle-fill"></i>
    </a>
  </div>

  <!-- KPI 2: Azul Corporativo (#0073B7) - Equipos Asignados / Ocupados -->
  <div class="kpi-box kpi-blue">
    <div class="kpi-box-inner">
      <div class="kpi-box-number"><%= statsEquipos.asignados %></div>
      <div class="kpi-box-title">Equipos en Servicio</div>
      <div class="kpi-box-sub">
        Asignados a clientes y proyectos
      </div>
      <i class="bi bi-box-arrow-up-right kpi-box-icon"></i>
    </div>
    <a href="/equipos?estado=OCUPADO" class="kpi-box-footer">
      <span>Ver equipos en servicio</span>
      <i class="bi bi-arrow-right-circle-fill"></i>
    </a>
  </div>

  <!-- KPI 3: Violeta / Índigo (#605CA8) - Accesorios & Materiales en Bodega -->
  <div class="kpi-box kpi-purple">
    <div class="kpi-box-inner">
      <div class="kpi-box-number"><%= statsAccesorios.totalUnidades %></div>
      <div class="kpi-box-title">Materiales y Fibra</div>
      <div class="kpi-box-sub">
        <strong><%= statsAccesorios.totalItems %></strong> rubros registrados
      </div>
      <i class="bi bi-tools kpi-box-icon"></i>
    </div>
    <a href="/accesorios" class="kpi-box-footer">
      <span>Gestionar materiales</span>
      <i class="bi bi-arrow-right-circle-fill"></i>
    </a>
  </div>

  <!-- KPI 4: Naranja / Ámbar (#F39C12) - Alertas de Stock Crítico (< 10) -->
  <div class="kpi-box <%= statsAccesorios.stockBajo > 0 ? 'kpi-orange' : 'kpi-teal' %>">
    <div class="kpi-box-inner">
      <div class="kpi-box-number"><%= statsAccesorios.stockBajo %></div>
      <div class="kpi-box-title">Stock Crítico (< 10)</div>
      <div class="kpi-box-sub">
        <%= statsAccesorios.stockBajo > 0 ? 'Artículos por reponer urgente' : 'Nivel de stock adecuado' %>
      </div>
      <i class="bi bi-shield-exclamation kpi-box-icon"></i>
    </div>
    <a href="/accesorios?stock_bajo=true" class="kpi-box-footer">
      <span>Ver artículos críticos</span>
      <i class="bi bi-arrow-right-circle-fill"></i>
    </a>
  </div>

</div>

<!-- FILA INFERIOR: RESUMEN LATERAL + TABLA DE MOVIMIENTOS RECIENTES -->
<div class="row g-3">
  
  <!-- Panel de Resumen Lateral (Widgets con Badges de Colores) -->
  <div class="col-12 col-xl-4">
    <div class="erp-box erp-box-blue">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-speedometer text-primary"></i> Estado General de Bodega
        </div>
      </div>
      <div class="erp-box-body p-0">
        <ul class="list-group list-group-flush" style="font-size: 13px;">
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-check-circle-fill text-success me-2"></i>Equipos en Stock Listo</span>
            <span class="badge-erp badge-erp-success font-tabular"><%= statsEquipos.disponibles %> Unidades</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-broadcast text-primary me-2"></i>Equipos en Clientes (Ocupados)</span>
            <span class="badge-erp badge-erp-primary font-tabular"><%= statsEquipos.asignados %> Unidades</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-wrench-adjustable text-purple me-2"></i>Equipos en Taller / Reparación</span>
            <span class="badge-erp badge-erp-purple font-tabular"><%= statsEquipos.mantenimiento %> Unidades</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Materiales Stock Crítico</span>
            <span class="badge-erp badge-erp-warning font-tabular"><%= statsAccesorios.stockBajo %> Artículos</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-layers text-info me-2"></i>Valor Estimado en Materiales</span>
            <span class="badge-erp badge-erp-gray font-tabular fw-bold text-dark">Bs. <%= Number(statsAccesorios.valorTotal || 0).toFixed(2) %></span>
          </li>
        </ul>
      </div>
      <div class="p-3 bg-light border-top d-flex gap-2 flex-wrap">
        <a href="/movimientos/equipos" class="btn-erp btn-erp-primary btn-erp-sm">
          <i class="bi bi-arrow-left-right"></i> Mover Equipo
        </a>
        <a href="/movimientos/accesorios" class="btn-erp btn-erp-success btn-erp-sm">
          <i class="bi bi-box-arrow-up-right"></i> Despacho Accesorio
        </a>
      </div>
    </div>
  </div>

  <!-- Tabla Administrativa: Últimos Movimientos Estilo DataTables -->
  <div class="col-12 col-xl-8">
    <div class="erp-box erp-box-teal">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-clock-history text-success"></i> Últimos Movimientos Registrados en Kardex
        </div>
        <a href="/movimientos/equipos" class="btn-erp btn-erp-default btn-erp-sm">
          Ver Kardex Completo →
        </a>
      </div>
      <div class="erp-box-body">
        
        <!-- Controles Superiores Estilo DataTables -->
        <div class="datatables-header-bar">
          <div class="datatables-length-select">
            <span>Mostrando últimos movimientos</span>
          </div>
          <div class="datatables-search-filter">
            <label>Buscar en tabla:</label>
            <input type="text" id="quickTableSearch" class="erp-input-sm" placeholder="Serie, equipo, destino..." style="width: 180px;">
          </div>
        </div>

        <!-- Tabla Estilo DataTables / AdminLTE -->
        <div class="table-responsive-erp">
          <table class="table-erp">
            <thead>
              <tr>
                <th>FECHA</th>
                <th>TIPO</th>
                <th>SERIE / MAC</th>
                <th>EQUIPO</th>
                <th>DESTINO</th>
                <th>ENCARGADO</th>
                <th class="actions-cell">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (ultimosMovimientos && ultimosMovimientos.length > 0) { %>
                <% ultimosMovimientos.forEach(m => { %>
                  <tr>
                    <td class="font-tabular">
                      <%= m.fecha_movimiento ? new Date(m.fecha_movimiento).toISOString().split('T')[0] : '-' %>
                    </td>
                    <td>
                      <% if (m.tipo_movimiento === 'SALIDA') { %>
                        <span class="badge-erp badge-erp-danger">SALIDA</span>
                      <% } else if (m.tipo_movimiento === 'ENTRADA') { %>
                        <span class="badge-erp badge-erp-success">ENTRADA</span>
                      <% } else { %>
                        <span class="badge-erp badge-erp-info"><%= m.tipo_movimiento %></span>
                      <% } %>
                    </td>
                    <td>
                      <span class="font-mono">
                        <%= m.numero_serie_mac %>
                        <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= m.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                          <i class="bi bi-clipboard"></i>
                        </button>
                      </span>
                    </td>
                    <td>
                      <strong><%= m.nombre_equipo || 'Equipo' %></strong>
                      <% if (m.modelo_equipo) { %>
                        <span class="text-muted ms-1">(<%= m.modelo_equipo %>)</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (m.destino) { %>
                        <span class="badge-erp badge-erp-gray"><i class="bi bi-geo-alt me-1 text-primary"></i><%= m.destino %></span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><%= m.encargado || '-' %></td>
                    <td class="actions-cell">
                      <a href="/movimientos/equipos" class="btn-erp btn-erp-default btn-erp-sm btn-erp-icon" title="Ver en kardex">
                        <i class="bi bi-eye text-primary"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">No hay movimientos recientes registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../layouts/footer') %>
