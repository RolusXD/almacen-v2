<%- include('../layouts/header', { title: 'Dashboard General', activeNav: 'dashboard' }) %>

<!-- 4 TARJETAS KPI SUPERIORES (OFICIAL ADMINLTE 4: SMALL-BOX) -->
<div class="row g-3 mb-4">
  
  <!-- KPI 1: text-bg-success - Equipos Disponibles -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="small-box text-bg-success shadow-sm rounded">
      <div class="inner">
        <h3 class="fw-bold"><%= statsEquipos.disponibles %></h3>
        <p class="mb-0">Equipos Disponibles</p>
        <small class="text-white-50">Total en almacén: <%= statsEquipos.total %></small>
      </div>
      <i class="small-box-icon bi bi-router"></i>
      <a href="/equipos?estado=DISPONIBLE" class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
        Ver catálogo <i class="bi bi-arrow-right-circle ms-1"></i>
      </a>
    </div>
  </div>

  <!-- KPI 2: text-bg-info - Equipos en Servicio -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="small-box text-bg-info shadow-sm rounded">
      <div class="inner">
        <h3 class="fw-bold"><%= statsEquipos.asignados %></h3>
        <p class="mb-0">Equipos en Servicio</p>
        <small class="text-white-50">Clientes e infraestructura</small>
      </div>
      <i class="small-box-icon bi bi-box-arrow-up-right"></i>
      <a href="/equipos?estado=OCUPADO" class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
        Ver activos <i class="bi bi-arrow-right-circle ms-1"></i>
      </a>
    </div>
  </div>

  <!-- KPI 3: text-bg-primary - Materiales y Fibra -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="small-box text-bg-primary shadow-sm rounded">
      <div class="inner">
        <h3 class="fw-bold"><%= statsAccesorios.totalUnidades %></h3>
        <p class="mb-0">Materiales y Fibra</p>
        <small class="text-white-50"><%= statsAccesorios.totalItems %> rubros en catálogo</small>
      </div>
      <i class="small-box-icon bi bi-tools"></i>
      <a href="/accesorios" class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
        Ver existencias <i class="bi bi-arrow-right-circle ms-1"></i>
      </a>
    </div>
  </div>

  <!-- KPI 4: text-bg-warning - Alertas de Stock Crítico -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="small-box <%= statsAccesorios.stockBajo > 0 ? 'text-bg-warning' : 'text-bg-secondary' %> shadow-sm rounded">
      <div class="inner">
        <h3 class="fw-bold"><%= statsAccesorios.stockBajo %></h3>
        <p class="mb-0">Alertas de Stock (< 10)</p>
        <small class="<%= statsAccesorios.stockBajo > 0 ? 'text-dark-50' : 'text-white-50' %>">
          <%= statsAccesorios.stockBajo > 0 ? 'Artículos por reponer' : 'Nivel óptimo' %>
        </small>
      </div>
      <i class="small-box-icon bi bi-shield-exclamation"></i>
      <a href="/accesorios?stockBajo=1" class="small-box-footer <%= statsAccesorios.stockBajo > 0 ? 'link-dark' : 'link-light' %> link-underline-opacity-0 link-underline-opacity-50-hover">
        Revisar alertas <i class="bi bi-arrow-right-circle ms-1"></i>
      </a>
    </div>
  </div>

</div>

<!-- FILA INFERIOR: RESUMEN LATERAL + TABLA DE MOVIMIENTOS RECIENTES -->
<div class="row g-3">
  
  <!-- Panel de Resumen Lateral (Card AdminLTE 4) -->
  <div class="col-12 col-xl-4">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header">
        <h3 class="card-title">
          <i class="bi bi-speedometer text-primary me-2"></i> Estado General de Bodega
        </h3>
      </div>
      <div class="card-body p-0">
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-check-circle-fill text-success me-2"></i>Equipos Disponibles</span>
            <span class="badge text-bg-success font-tabular"><%= statsEquipos.disponibles %> Unidades</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-broadcast text-primary me-2"></i>Equipos en Servicio</span>
            <span class="badge text-bg-primary font-tabular"><%= statsEquipos.asignados %> Unidades</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-wrench-adjustable text-warning me-2"></i>Equipos en Taller / Falla</span>
            <span class="badge text-bg-warning font-tabular"><%= statsEquipos.mantenimiento %> Unidades</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Materiales Stock Crítico</span>
            <span class="badge text-bg-danger font-tabular"><%= statsAccesorios.stockBajo %> Artículos</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
            <span><i class="bi bi-currency-dollar text-info me-2"></i>Valor Estimado Materiales</span>
            <span class="badge bg-body-secondary border text-body font-tabular fw-bold">Bs. <%= Number(statsAccesorios.valorTotal || 0).toFixed(2) %></span>
          </li>
        </ul>
      </div>
      <div class="card-footer bg-body-tertiary d-grid">
        <a href="/despachos/nuevo" class="btn btn-primary fw-bold shadow-sm py-2">
          <i class="bi bi-plus-circle-fill me-1"></i> + Nuevo Despacho
        </a>
      </div>
    </div>
  </div>

  <!-- Tabla Administrativa: Últimos Movimientos (Card AdminLTE 4) -->
  <div class="col-12 col-xl-8">
    <div class="card card-success card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">
          <i class="bi bi-clock-history text-success me-2"></i> Últimos Movimientos Registrados
        </h3>
        <div class="card-tools ms-auto">
          <a href="/movimientos/equipos" class="btn btn-outline-secondary btn-sm">
            Ver Kardex Completo <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
      <div class="card-body">
        
        <!-- Controles Superiores de Búsqueda -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <span class="text-muted small">Registros recientes de operaciones</span>
          <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small text-muted">Buscar:</label>
            <input type="text" id="quickTableSearch" class="form-control form-control-sm" placeholder="Serie, equipo, destino..." style="width: 200px;">
          </div>
        </div>

        <!-- Tabla Estilo AdminLTE 4 -->
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="min-width: 95px;">FECHA</th>
                <th style="min-width: 85px;">TIPO</th>
                <th style="min-width: 130px;">SERIE / MAC</th>
                <th style="min-width: 140px;">EQUIPO</th>
                <th style="min-width: 150px;">DESTINO</th>
                <th style="min-width: 130px;">ENCARGADO</th>
                <th class="text-end" style="min-width: 75px;">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (ultimosMovimientos && ultimosMovimientos.length > 0) { %>
                <% ultimosMovimientos.forEach(m => { %>
                  <tr>
                    <td class="font-tabular small">
                      <%= m.fecha_movimiento ? new Date(m.fecha_movimiento).toISOString().split('T')[0] : '-' %>
                    </td>
                    <td>
                      <% if (m.tipo_movimiento === 'SALIDA') { %>
                        <span class="badge text-bg-danger">SALIDA</span>
                      <% } else if (m.tipo_movimiento === 'ENTRADA') { %>
                        <span class="badge text-bg-success">ENTRADA</span>
                      <% } else { %>
                        <span class="badge text-bg-info"><%= m.tipo_movimiento %></span>
                      <% } %>
                    </td>
                    <td>
                      <span class="font-mono text-primary fw-semibold">
                        <%= m.numero_serie_mac %>
                        <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= m.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                          <i class="bi bi-clipboard"></i>
                        </button>
                      </span>
                    </td>
                    <td>
                      <strong><%= m.nombre_equipo || 'Equipo' %></strong>
                      <% if (m.modelo_equipo) { %>
                        <span class="text-muted small ms-1">(<%= m.modelo_equipo %>)</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (m.destino) { %>
                        <span class="badge bg-body-secondary border text-body text-wrap text-start" style="max-width: 170px; font-size: 11px; white-space: normal; line-height: 1.3;"><i class="bi bi-geo-alt me-1 text-primary"></i><%= m.destino %></span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><%= m.encargado || '-' %></td>
                    <td class="text-end">
                      <a href="/movimientos/equipos" class="btn btn-outline-primary btn-sm" title="Ver en kardex">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">No hay movimientos recientes registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../layouts/footer') %>
