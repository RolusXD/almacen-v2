<%- include('../layouts/header', { title: 'Control de Préstamos', activeNav: 'prestamos' }) %>

<div class="row g-3">
  <!-- Formulario de Préstamo (Box Estilo Mikrowisp / AdminLTE) -->
  <div class="col-12 col-xl-4">
    <div class="erp-box erp-box-purple">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-handbag text-purple"></i> Registrar Préstamo de Equipo
        </div>
      </div>
      <div class="erp-box-body">
        <form method="POST" action="/maestros/prestamos">
          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">N° SERIE / MAC DEL EQUIPO <span class="text-danger">*</span></label>
            <input type="text" name="numero_serie_mac" class="erp-input-sm w-100 font-mono" placeholder="Ej: 445121884JXX" required autofocus>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">NOMBRE DEL SOLICITANTE <span class="text-danger">*</span></label>
            <input type="text" name="nombre_solicita" class="erp-input-sm w-100" placeholder="Nombre de la persona solicitante" required>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">DEPARTAMENTO / ÁREA</label>
              <input type="text" name="departamento" class="erp-input-sm w-100" placeholder="Ej: Soporte, Ventas">
            </div>
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">TELÉFONO CONTACTO</label>
              <input type="text" name="telefono_contacto" class="erp-input-sm w-100 font-tabular" placeholder="Ej: 71234567">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">MOTIVO DEL PRÉSTAMO <span class="text-danger">*</span></label>
            <textarea name="motivo_prestamo" rows="2" class="erp-input-sm w-100" placeholder="Ej: Pruebas técnicas de laboratorio o evento" required></textarea>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">FECHA PRÉSTAMO</label>
              <input type="date" name="fecha_prestamo" class="erp-input-sm w-100 font-tabular" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">DEVOLUCIÓN ESP. <span class="text-danger">*</span></label>
              <input type="date" name="fecha_devolucion_esperada" class="erp-input-sm w-100 font-tabular" value="<%= new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0] %>" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">OBSERVACIONES DE SALIDA</label>
            <input type="text" name="observaciones_salida" class="erp-input-sm w-100" placeholder="Accesorios entregados con el equipo...">
          </div>

          <button type="submit" class="btn-erp btn-erp-purple w-100 py-2">
            <i class="bi bi-save me-1"></i> Registrar Préstamo de Equipo
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado de Préstamos Estilo DataTables -->
  <div class="col-12 col-xl-8">
    <div class="erp-box erp-box-blue">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-card-checklist text-primary"></i> Control de Préstamos de Equipos
        </div>
        <span class="badge-erp badge-erp-primary"><%= prestamos.length %> Registros</span>
      </div>
      <div class="erp-box-body">
        
        <!-- Barra de Control Estilo DataTables -->
        <div class="datatables-header-bar">
          <div class="datatables-length-select">
            <span>Mostrar <strong>10</strong> registros por página</span>
          </div>
          <div class="datatables-search-filter">
            <label>Buscar:</label>
            <input type="text" id="quickTableSearch" class="erp-input-sm" placeholder="Filtrar préstamos..." style="width: 200px;">
          </div>
        </div>

        <div class="table-responsive-erp">
          <table class="table-erp">
            <thead>
              <tr>
                <th>FECHA</th>
                <th>SERIE / MAC</th>
                <th>EQUIPO</th>
                <th>SOLICITANTE</th>
                <th>ÁREA</th>
                <th>DEV. ESPERADA</th>
                <th>ESTADO</th>
                <th class="actions-cell">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (prestamos && prestamos.length > 0) { %>
                <% prestamos.forEach(p => { %>
                  <tr>
                    <td class="col-fecha font-tabular">
                      <%= p.fecha_prestamo ? new Date(p.fecha_prestamo).toISOString().split('T')[0] : '-' %>
                    </td>
                    <td>
                      <span class="font-mono text-primary" style="font-weight: 600;">
                        <%= p.numero_serie_mac %>
                        <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= p.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                          <i class="bi bi-clipboard"></i>
                        </button>
                      </span>
                    </td>
                    <td>
                      <strong><%= p.nombre_equipo || 'Equipo' %></strong>
                      <% if (p.modelo_equipo) { %>
                        <span class="text-muted ms-1">(<%= p.modelo_equipo %>)</span>
                      <% } %>
                    </td>
                    <td>
                      <strong><%= p.nombre_solicita %></strong>
                      <% if (p.telefono_contacto) { %>
                        <span class="text-muted ms-1 font-tabular">(<%= p.telefono_contacto %>)</span>
                      <% } %>
                    </td>
                    <td><%= p.departamento || '-' %></td>
                    <td class="col-fecha font-tabular">
                      <%= p.fecha_devolucion_esperada ? new Date(p.fecha_devolucion_esperada).toISOString().split('T')[0] : '-' %>
                    </td>
                    <td>
                      <% if (p.estado === 'PRESTADO') { %>
                        <span class="badge-erp badge-erp-warning">PRESTADO</span>
                      <% } else if (p.estado === 'DEVUELTO') { %>
                        <span class="badge-erp badge-erp-success">DEVUELTO</span>
                      <% } else if (p.estado === 'ATRASADO') { %>
                        <span class="badge-erp badge-erp-danger">ATRASADO</span>
                      <% } else { %>
                        <span class="badge-erp badge-erp-purple"><%= p.estado %></span>
                      <% } %>
                    </td>
                    <td class="actions-cell">
                      <% if (p.estado === 'PRESTADO' || p.estado === 'ATRASADO') { %>
                        <form method="POST" action="/maestros/prestamos/devolver/<%= p.id_prestamo %>" style="display: inline;" onsubmit="return confirm('¿Confirmar que el equipo fue retornado a almacén y pasa a DISPONIBLE?');">
                          <button type="submit" class="btn-erp btn-erp-success btn-sm" title="Registrar retorno">
                            <i class="bi bi-box-arrow-in-down"></i> Retornar
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-muted" style="font-size: 11px;"><i class="bi bi-check2-all text-success"></i> Entregado</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-muted py-4">No se registran préstamos activos.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
