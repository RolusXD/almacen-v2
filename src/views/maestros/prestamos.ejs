<%- include('../layouts/header', { title: 'Control de Préstamos', activeNav: 'prestamos' }) %>

<div class="row g-3">
  <!-- Formulario de Préstamo (Card AdminLTE 4) -->
  <div class="col-12 col-xl-4">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header">
        <h3 class="card-title">
          <i class="bi bi-handbag text-primary me-2"></i> Registrar Préstamo de Equipo
        </h3>
      </div>
      <div class="card-body">
        <form method="POST" action="/maestros/prestamos">
          <div class="mb-3">
            <label class="form-label fw-semibold">N° SERIE / MAC DEL EQUIPO <span class="text-danger">*</span></label>
            <input type="text" name="numero_serie_mac" class="form-control font-mono" placeholder="Ej: 445121884JXX" required autofocus>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">NOMBRE DEL SOLICITANTE <span class="text-danger">*</span></label>
            <input type="text" name="nombre_solicita" class="form-control" placeholder="Nombre de la persona solicitante" required>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label fw-semibold">DEPARTAMENTO / ÁREA</label>
              <input type="text" name="departamento" class="form-control" placeholder="Ej: Soporte, Ventas">
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">TELÉFONO CONTACTO</label>
              <input type="text" name="telefono_contacto" class="form-control font-tabular" placeholder="Ej: 71234567">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">MOTIVO DEL PRÉSTAMO <span class="text-danger">*</span></label>
            <textarea name="motivo_prestamo" rows="2" class="form-control" placeholder="Ej: Pruebas técnicas de laboratorio o evento" required></textarea>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label fw-semibold">FECHA PRÉSTAMO</label>
              <input type="date" name="fecha_prestamo" class="form-control font-tabular" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">DEVOLUCIÓN ESP. <span class="text-danger">*</span></label>
              <input type="date" name="fecha_devolucion_esperada" class="form-control font-tabular" value="<%= new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0] %>" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">OBSERVACIONES DE SALIDA</label>
            <input type="text" name="observaciones_salida" class="form-control" placeholder="Accesorios entregados con el equipo...">
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2">
            <i class="bi bi-save me-1"></i> Registrar Préstamo de Equipo
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado de Préstamos (Card AdminLTE 4) -->
  <div class="col-12 col-xl-8">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title">
          <i class="bi bi-card-checklist text-primary me-2"></i> Control de Préstamos de Equipos
        </h3>
        <span class="badge text-bg-primary ms-auto"><%= prestamos.length %> Registros</span>
      </div>
      <div class="card-body">
        
        <!-- Barra de Control -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 bg-light p-2 rounded border">
          <span class="small text-muted">Préstamos temporales activos</span>
          <div class="d-flex align-items-center gap-2 ms-auto">
            <label class="form-label mb-0 small text-muted">Buscar:</label>
            <input type="text" id="quickTableSearch" class="form-control form-control-sm" placeholder="Filtrar préstamos..." style="width: 200px;">
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>FECHA</th>
                <th>SERIE / MAC</th>
                <th>EQUIPO</th>
                <th>SOLICITANTE</th>
                <th>ÁREA</th>
                <th>DEV. ESPERADA</th>
                <th>ESTADO</th>
                <th class="text-end">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (prestamos && prestamos.length > 0) { %>
                <% prestamos.forEach(p => { %>
                  <tr>
                    <td class="font-tabular small">
                      <%= p.fecha_prestamo ? new Date(p.fecha_prestamo).toISOString().split('T')[0] : '-' %>
                    </td>
                    <td>
                      <span class="font-mono text-primary fw-semibold">
                        <%= p.numero_serie_mac %>
                        <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= p.numero_serie_mac %>', 'Serie/MAC')" title="Copiar serie">
                          <i class="bi bi-clipboard"></i>
                        </button>
                      </span>
                    </td>
                    <td>
                      <strong><%= p.nombre_equipo || 'Equipo' %></strong>
                      <% if (p.modelo_equipo) { %>
                        <small class="text-muted ms-1">(<%= p.modelo_equipo %>)</small>
                      <% } %>
                    </td>
                    <td>
                      <strong><%= p.nombre_solicita %></strong>
                      <% if (p.telefono_contacto) { %>
                        <small class="text-muted ms-1 font-tabular">(<%= p.telefono_contacto %>)</small>
                      <% } %>
                    </td>
                    <td><%= p.departamento || '-' %></td>
                    <td class="font-tabular small">
                      <%= p.fecha_devolucion_esperada ? new Date(p.fecha_devolucion_esperada).toISOString().split('T')[0] : '-' %>
                    </td>
                    <td>
                      <% if (p.estado === 'PRESTADO') { %>
                        <span class="badge text-bg-warning">PRESTADO</span>
                      <% } else if (p.estado === 'DEVUELTO') { %>
                        <span class="badge text-bg-success">DEVUELTO</span>
                      <% } else if (p.estado === 'ATRASADO') { %>
                        <span class="badge text-bg-danger">ATRASADO</span>
                      <% } else { %>
                        <span class="badge text-bg-secondary"><%= p.estado %></span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <% if (p.estado === 'PRESTADO' || p.estado === 'ATRASADO') { %>
                        <form method="POST" action="/maestros/prestamos/devolver/<%= p.id_prestamo %>" style="display: inline;" onsubmit="return confirm('¿Confirmar que el equipo fue retornado a almacén y pasa a DISPONIBLE?');">
                          <button type="submit" class="btn btn-success btn-sm" title="Registrar retorno">
                            <i class="bi bi-box-arrow-in-down me-1"></i> Retornar
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-muted small"><i class="bi bi-check2-all text-success"></i> Entregado</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-muted py-4">No se registran préstamos activos.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
