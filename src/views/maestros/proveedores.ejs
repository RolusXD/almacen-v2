<%- include('../layouts/header', { title: 'Proveedores', activeNav: 'proveedores' }) %>

<div class="row g-3">
  <!-- Formulario de Nuevo Proveedor (Box Estilo Mikrowisp / AdminLTE) -->
  <div class="col-12 col-xl-4">
    <div class="erp-box erp-box-blue">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-truck text-primary"></i> Registrar Proveedor
        </div>
      </div>
      <div class="erp-box-body">
        <form method="POST" action="/maestros/proveedores">
          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">NOMBRE DE LA EMPRESA <span class="text-danger">*</span></label>
            <input type="text" name="nombre_empresa" class="erp-input-sm w-100" placeholder="Ej: DIGICORP S.R.L. o COMRADE" required>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">NIT (BOLIVIA)</label>
            <input type="text" name="nit" class="erp-input-sm w-100" placeholder="Ej: 1028374029">
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">CONTACTO</label>
              <input type="text" name="contacto" class="erp-input-sm w-100" placeholder="Nombre contacto">
            </div>
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">TELÉFONO</label>
              <input type="text" name="telefono" class="erp-input-sm w-100" placeholder="70012345">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">CORREO ELECTRÓNICO</label>
            <input type="email" name="email" class="erp-input-sm w-100" placeholder="ventas@proveedor.com">
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">DIRECCIÓN</label>
            <input type="text" name="direccion" class="erp-input-sm w-100" placeholder="Ciudad, calle o zona">
          </div>

          <button type="submit" class="btn-erp btn-erp-primary w-100 py-2">
            <i class="bi bi-save me-1"></i> Guardar Proveedor
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado de Proveedores Estilo DataTables -->
  <div class="col-12 col-xl-8">
    <div class="erp-box erp-box-teal">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-buildings text-success"></i> Proveedores Registrados
        </div>
        <span class="badge-erp badge-erp-success"><%= proveedores.length %> Proveedores</span>
      </div>
      <div class="erp-box-body">
        
        <!-- Barra de Control Estilo DataTables -->
        <div class="datatables-header-bar">
          <div class="datatables-length-select">
            <span>Mostrar <strong>10</strong> registros por página</span>
          </div>
          <div class="datatables-search-filter">
            <label>Buscar:</label>
            <input type="text" id="quickTableSearch" class="erp-input-sm" placeholder="Filtrar proveedores..." style="width: 180px;">
          </div>
        </div>

        <div class="table-responsive-erp">
          <table class="table-erp">
            <thead>
              <tr>
                <th>EMPRESA</th>
                <th>NIT (BOLIVIA)</th>
                <th>CONTACTO</th>
                <th class="col-number">TELÉFONO</th>
                <th>CORREO</th>
                <th>DIRECCIÓN</th>
                <th class="actions-cell">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (proveedores && proveedores.length > 0) { %>
                <% proveedores.forEach(p => { %>
                  <tr>
                    <td><strong><%= p.nombre_empresa %></strong></td>
                    <td>
                      <% if (p.nit) { %>
                        <span class="font-mono font-tabular text-primary" style="font-weight: 600;">
                          <%= p.nit %>
                          <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= p.nit %>', 'NIT')" title="Copiar NIT">
                            <i class="bi bi-clipboard"></i>
                          </button>
                        </span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><%= p.contacto || '-' %></td>
                    <td class="col-number font-tabular"><%= p.telefono || '-' %></td>
                    <td><%= p.email || '-' %></td>
                    <td><small class="text-muted"><%= p.direccion || '-' %></small></td>
                    <td class="actions-cell">
                      <a href="/maestros/proveedores/eliminar/<%= p.id_proveedor %>" class="btn-erp btn-erp-danger btn-sm" title="Desactivar" onclick="return confirm('¿Desactivar proveedor <%= p.nombre_empresa %>?');">
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">No hay proveedores registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
