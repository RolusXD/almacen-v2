<%- include('../layouts/header', { title: 'Proveedores', activeNav: 'proveedores' }) %>

<div class="row g-3">
  <!-- Formulario de Nuevo Proveedor -->
  <div class="col-12 col-xl-4">
    <div class="mw-card">
      <div class="mw-card-header">
        <span class="mw-card-title"><i class="bi bi-truck text-primary"></i> Registrar Proveedor</span>
      </div>
      <div class="mw-card-body">
        <form method="POST" action="/maestros/proveedores">
          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">NOMBRE DE LA EMPRESA <span class="text-danger">*</span></label>
            <input type="text" name="nombre_empresa" class="mw-input w-100" placeholder="Ej: DIGICORP S.R.L. o COMRADE" required>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">NIT (BOLIVIA)</label>
            <input type="text" name="nit" class="mw-input w-100" placeholder="Ej: 1028374029">
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">CONTACTO</label>
              <input type="text" name="contacto" class="mw-input w-100" placeholder="Nombre contacto">
            </div>
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">TELÉFONO</label>
              <input type="text" name="telefono" class="mw-input w-100" placeholder="70012345">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">CORREO ELECTRÓNICO</label>
            <input type="email" name="email" class="mw-input w-100" placeholder="ventas@proveedor.com">
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">DIRECCIÓN</label>
            <input type="text" name="direccion" class="mw-input w-100" placeholder="Ciudad, calle o zona">
          </div>

          <button type="submit" class="mw-btn mw-btn-primary w-100" style="padding: 0.55rem; justify-content: center;">
            <i class="bi bi-save"></i> Guardar Proveedor
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado de Proveedores -->
  <div class="col-12 col-xl-8">
    <div class="mw-card">
      <div class="mw-card-header">
        <span class="mw-card-title"><i class="bi bi-buildings text-primary"></i> Proveedores Registrados</span>
        <div class="d-flex align-items-center gap-2">
          <input type="text" id="quickTableSearch" class="mw-input" placeholder="Filtrar proveedores..." style="width: 200px;">
          <span class="badge-mw badge-neutral"><%= proveedores.length %> activos</span>
        </div>
      </div>
      <div class="mw-card-body p-0">
        <div class="mw-table-container">
          <table class="mw-table">
            <thead>
              <tr>
                <th>EMPRESA</th>
                <th>NIT (BOLIVIA)</th>
                <th>CONTACTO</th>
                <th class="col-number">TELÉFONO</th>
                <th>CORREO</th>
                <th>DIRECCIÓN</th>
                <th class="actions-cell">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (proveedores && proveedores.length > 0) { %>
                <% proveedores.forEach(p => { %>
                  <tr>
                    <td><strong><%= p.nombre_empresa %></strong></td>
                    <td>
                      <% if (p.nit) { %>
                        <span class="font-mono font-tabular">
                          <%= p.nit %>
                          <button type="button" class="btn-copy-inline" onclick="copyToClipboard('<%= p.nit %>', 'NIT')" title="Copiar NIT">
                            <i class="bi bi-clipboard"></i>
                          </button>
                        </span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><%= p.contacto || '-' %></td>
                    <td class="col-number font-tabular"><%= p.telefono || '-' %></td>
                    <td><%= p.email || '-' %></td>
                    <td><small class="text-muted"><%= p.direccion || '-' %></small></td>
                    <td class="actions-cell">
                      <a href="/maestros/proveedores/eliminar/<%= p.id_proveedor %>" class="mw-btn mw-btn-danger-outline mw-btn-sm mw-btn-icon" title="Desactivar" onclick="return confirm('¿Desactivar proveedor <%= p.nombre_empresa %>?');">
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">No hay proveedores registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
