<%- include('../layouts/header', { title: 'Mantenimientos', activeNav: 'mantenimientos' }) %>

<div class="row g-3">
  <!-- Formulario -->
  <div class="col-12 col-xl-4">
    <div class="mw-card">
      <div class="mw-card-header">
        <span class="mw-card-title"><i class="bi bi-wrench-adjustable text-primary"></i> Ingreso a Taller / Mantenimiento</span>
      </div>
      <div class="mw-card-body">
        <form method="POST" action="/maestros/mantenimientos">
          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">N° SERIE / MAC DEL EQUIPO <span class="text-danger">*</span></label>
            <input type="text" name="numero_serie_mac" class="mw-input w-100" placeholder="Ej: 445121884JXX" required>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">TIPO DE FALLA <span class="text-danger">*</span></label>
            <input type="text" name="tipo_falla" class="mw-input w-100" placeholder="Ej: No enciende, puertos ethernet quemados..." required>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">TÉCNICO RESPONSABLE <span class="text-danger">*</span></label>
            <input type="text" name="tecnico_responsable" class="mw-input w-100" placeholder="Nombre del técnico que revisa..." required>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">COSTO REP. (Bs.)</label>
              <input type="number" step="0.01" name="costo_reparacion" class="mw-input w-100" value="0.00">
            </div>
            <div class="col-6">
              <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">FECHA INGRESO</label>
              <input type="date" name="fecha_ingreso" class="mw-input w-100" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #475569;">DIAGNÓSTICO INICIAL</label>
            <textarea name="diagnostico" rows="2" class="mw-input w-100" placeholder="Detalles de la inspección inicial..."></textarea>
          </div>

          <button type="submit" class="mw-btn mw-btn-primary w-100" style="padding: 0.55rem; justify-content: center;">
            <i class="bi bi-save"></i> Registrar Mantenimiento
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado -->
  <div class="col-12 col-xl-8">
    <div class="mw-card">
      <div class="mw-card-header">
        <span class="mw-card-title"><i class="bi bi-card-checklist text-primary"></i> Equipos en Mantenimiento / Taller</span>
        <span class="text-muted" style="font-size: 11.5px;">Total: <strong><%= mantenimientos.length %></strong></span>
      </div>
      <div class="mw-card-body p-0">
        <div class="mw-table-container">
          <table class="mw-table">
            <thead>
              <tr>
                <th>FECHA</th>
                <th>N° SERIE / MAC</th>
                <th>EQUIPO</th>
                <th>FALLA</th>
                <th>TÉCNICO</th>
                <th>COSTO</th>
                <th>ESTADO</th>
              </tr>
            </thead>
            <tbody>
              <% if (mantenimientos && mantenimientos.length > 0) { %>
                <% mantenimientos.forEach(m => { %>
                  <tr>
                    <td><%= m.fecha_ingreso ? new Date(m.fecha_ingreso).toISOString().split('T')[0] : '-' %></td>
                    <td><span class="badge-mw badge-neutral" style="font-family: monospace;"><%= m.numero_serie_mac %></span></td>
                    <td><strong><%= m.nombre_equipo || '-' %></strong></td>
                    <td><%= m.tipo_falla %></td>
                    <td><%= m.tecnico_responsable %></td>
                    <td>Bs. <%= Number(m.costo_reparacion || 0).toFixed(2) %></td>
                    <td><span class="badge-mw badge-mantenimiento"><%= m.estado %></span></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">No hay equipos actualmente en mantenimiento.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
