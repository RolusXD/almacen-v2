<%- include('../layouts/header', { title: 'Gestión de Categorías', activeNav: 'categorias' }) %>

<div class="row g-3">
  <!-- Listado de Categorías (100% Ancho Full-Width) -->
  <div class="col-12">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title">
          <i class="bi bi-folder2-open text-primary me-2"></i> Catálogo de Categorías Registradas
        </h3>
        <div class="card-tools d-flex align-items-center gap-2 ms-auto">
          <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaCategoria">
            <i class="bi bi-folder-plus me-1"></i> Nueva Categoría
          </button>
          <span class="badge text-bg-primary"><%= categorias.length %> Categorías</span>
        </div>
      </div>
      <div class="card-body">
        
        <!-- Barra de Control y Búsqueda -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 bg-body-tertiary p-2 rounded border">
          <span class="small text-body-secondary">Listado maestro de clasificación</span>
          <div class="d-flex align-items-center gap-2 ms-auto">
            <label class="form-label mb-0 small text-body">Buscar:</label>
            <input type="text" id="quickTableSearch" class="form-control form-control-sm" placeholder="Filtrar categorías..." style="width: 200px;">
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>NOMBRE</th>
                <th>DESCRIPCIÓN</th>
                <th class="text-end">EQUIPOS</th>
                <th class="text-end">ACCESORIOS</th>
                <th class="text-end">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (categorias && categorias.length > 0) { %>
                <% categorias.forEach(c => { %>
                  <tr>
                    <td>
                      <span class="fw-bold text-body"><%= c.nombre %></span>
                    </td>
                    <td><small class="text-body-secondary"><%= c.descripcion || '-' %></small></td>
                    <td class="text-end font-tabular">
                      <span class="badge text-bg-primary"><%= c.total_equipos || 0 %></span>
                    </td>
                    <td class="text-end font-tabular">
                      <span class="badge text-bg-success"><%= c.total_accesorios || 0 %></span>
                    </td>
                    <td class="text-end">
                      <a href="/maestros/categorias/eliminar/<%= c.id_categoria %>" class="btn btn-outline-danger btn-sm" title="Desactivar categoría" onclick="return confirm('¿Desactivar la categoría <%= c.nombre %>?');">
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">No hay categorías registradas en el sistema.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Flotante de Creación de Categoría -->
<div class="modal fade" id="modalNuevaCategoria" tabindex="-1" aria-labelledby="modalNuevaCategoriaLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title fw-bold" id="modalNuevaCategoriaLabel">
          <i class="bi bi-folder-plus me-2"></i> Registrar Nueva Categoría
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <form method="POST" action="/maestros/categorias">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-semibold">NOMBRE DE LA CATEGORÍA <span class="text-danger">*</span></label>
            <input type="text" name="nombre" class="form-control" placeholder="Ej: ROUTER, SWITCH, FIBRA ÓPTICA" required autofocus>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">DESCRIPCIÓN OPERATIVA</label>
            <textarea name="descripcion" rows="3" class="form-control" placeholder="Descripción del grupo o rubro..."></textarea>
          </div>
        </div>
        <div class="modal-footer bg-body-tertiary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-save me-1"></i> Guardar Categoría
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
