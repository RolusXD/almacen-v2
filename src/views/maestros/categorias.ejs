<%- include('../layouts/header', { title: 'Gestión de Categorías', activeNav: 'categorias' }) %>

<div class="row g-3">
  
  <!-- Formulario de Creación (Box Estilo AdminLTE / Mikrowisp) -->
  <div class="col-12 col-xl-4">
    <div class="erp-box erp-box-teal">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-folder-plus text-success"></i> Nueva Categoría
        </div>
      </div>
      <div class="erp-box-body">
        <form method="POST" action="/maestros/categorias">
          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">NOMBRE DE LA CATEGORÍA <span class="text-danger">*</span></label>
            <input type="text" name="nombre" class="erp-input-sm w-100" placeholder="Ej: ROUTER, SWITCH, FIBRA ÓPTICA" required autofocus>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">DESCRIPCIÓN OPERATIVA</label>
            <textarea name="descripcion" rows="3" class="erp-input-sm w-100" placeholder="Descripción del grupo o rubro..."></textarea>
          </div>

          <button type="submit" class="btn-erp btn-erp-success w-100 py-2">
            <i class="bi bi-save me-1"></i> Guardar Categoría
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado de Categorías Estilo DataTables -->
  <div class="col-12 col-xl-8">
    <div class="erp-box erp-box-blue">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-folder2-open text-primary"></i> Catálogo de Categorías Registradas
        </div>
        <span class="badge-erp badge-erp-primary"><%= categorias.length %> Categorías</span>
      </div>
      <div class="erp-box-body">
        
        <!-- Barra de Control Estilo DataTables -->
        <div class="datatables-header-bar">
          <div class="datatables-length-select">
            <span>Mostrar <strong>10</strong> registros por página</span>
          </div>
          <div class="datatables-search-filter">
            <label>Buscar:</label>
            <input type="text" id="quickTableSearch" class="erp-input-sm" placeholder="Filtrar categorías..." style="width: 180px;">
          </div>
        </div>

        <div class="table-responsive-erp">
          <table class="table-erp">
            <thead>
              <tr>
                <th>NOMBRE</th>
                <th>DESCRIPCIÓN</th>
                <th class="col-number">EQUIPOS</th>
                <th class="col-number">ACCESORIOS</th>
                <th class="actions-cell">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (categorias && categorias.length > 0) { %>
                <% categorias.forEach(c => { %>
                  <tr>
                    <td>
                      <i class="bi bi-folder2 text-primary me-1"></i>
                      <strong class="text-dark"><%= c.nombre %></strong>
                    </td>
                    <td>
                      <span class="text-muted"><%= c.descripcion || '-' %></span>
                    </td>
                    <td class="col-number font-tabular">
                      <span class="badge-erp badge-erp-success font-tabular">
                        <%= c.total_equipos || 0 %> equipos
                      </span>
                    </td>
                    <td class="col-number font-tabular">
                      <span class="badge-erp badge-erp-info font-tabular">
                        <%= c.total_accesorios || 0 %> materiales
                      </span>
                    </td>
                    <td class="actions-cell">
                      <a href="/maestros/categorias/eliminar/<%= c.id_categoria %>" class="btn-erp btn-erp-danger btn-erp-sm btn-erp-icon" title="Desactivar categoría" onclick="return confirm('¿Desactivar la categoría <%= c.nombre %>?');">
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">No se registran categorías activas.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../layouts/footer') %>
