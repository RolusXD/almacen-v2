<%- include('../layouts/header', { title: 'Gestión de Categorías', activeNav: 'categorias' }) %>

<div class="row g-3">
  <!-- Formulario de Creación -->
  <div class="col-12 col-xl-4">
    <div class="mw-card">
      <div class="mw-card-header">
        <span class="mw-card-title"><i class="bi bi-folder-plus text-primary"></i> Nueva Categoría</span>
      </div>
      <div class="mw-card-body">
        <form method="POST" action="/maestros/categorias">
          <div class="form-group-wms">
            <label class="form-label-wms">NOMBRE DE LA CATEGORÍA <span class="text-danger">*</span></label>
            <input type="text" name="nombre" class="mw-input w-100" placeholder="Ej: ROUTER, SWITCH, FIBRA ÓPTICA" required autofocus>
          </div>

          <div class="form-group-wms">
            <label class="form-label-wms">DESCRIPCIÓN OPERATIVA</label>
            <textarea name="descripcion" rows="3" class="mw-input w-100" placeholder="Descripción del grupo o rubro..."></textarea>
          </div>

          <button type="submit" class="mw-btn mw-btn-primary w-100 mw-btn-touch mt-2">
            <i class="bi bi-save"></i> Guardar Categoría
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado de Categorías WMS UI Pro -->
  <div class="col-12 col-xl-8">
    <div class="mw-card">
      <div class="mw-card-header">
        <span class="mw-card-title"><i class="bi bi-folder2-open text-primary"></i> Categorías Registradas</span>
        <div class="d-flex align-items-center gap-2">
          <input type="text" id="quickTableSearch" class="mw-input" placeholder="Filtrar categorías..." style="width: 200px;">
          <span class="badge-mw badge-neutral"><%= categorias.length %> activas</span>
        </div>
      </div>
      <div class="mw-card-body p-0">
        <div class="mw-table-container">
          <table class="mw-table">
            <thead>
              <tr>
                <th>NOMBRE</th>
                <th>DESCRIPCIÓN</th>
                <th class="col-number">EQUIPOS</th>
                <th class="col-number">ACCESORIOS</th>
                <th class="actions-cell">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (categorias && categorias.length > 0) { %>
                <% categorias.forEach(c => { %>
                  <tr>
                    <td>
                      <span class="fw-bold text-dark"><i class="bi bi-folder2 me-1 text-primary"></i><%= c.nombre %></span>
                    </td>
                    <td>
                      <span class="text-muted"><%= c.descripcion || '-' %></span>
                    </td>
                    <td class="col-number font-tabular">
                      <span class="badge-mw badge-wms-optimo font-tabular">
                        <%= c.total_equipos || 0 %> equipos
                      </span>
                    </td>
                    <td class="col-number font-tabular">
                      <span class="badge-mw badge-wms-transito font-tabular">
                        <%= c.total_accesorios || 0 %> materiales
                      </span>
                    </td>
                    <td class="actions-cell">
                      <a href="/maestros/categorias/eliminar/<%= c.id_categoria %>" class="mw-btn mw-btn-danger-outline mw-btn-sm mw-btn-icon" title="Desactivar categoría" onclick="return confirm('¿Desactivar la categoría <%= c.nombre %>?');">
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">No se registran categorías activas.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
