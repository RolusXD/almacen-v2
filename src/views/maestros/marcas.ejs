<%- include('../layouts/header', { title: 'Marcas', activeNav: 'marcas' }) %>

<div class="row g-3">
  <!-- Listado de Marcas (100% Ancho Full-Width) -->
  <div class="col-12">
    <div class="card card-primary card-outline shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title">
          <i class="bi bi-bookmark-star text-primary me-2"></i> Marcas Registradas
        </h3>
        <div class="card-tools d-flex align-items-center gap-2 ms-auto">
          <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaMarca">
            <i class="bi bi-bookmark-plus me-1"></i> + Registrar Marca
          </button>
          <span class="badge text-bg-primary"><%= marcas.length %> Marcas</span>
        </div>
      </div>
      <div class="card-body">
        
        <!-- Barra de Control -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 bg-body-tertiary p-2 rounded border">
          <span class="small text-body-secondary">Fabricantes y marcas homologadas</span>
          <div class="d-flex align-items-center gap-2 ms-auto">
            <label class="form-label mb-0 small text-body">Buscar:</label>
            <input type="text" id="quickTableSearch" class="form-control form-control-sm" placeholder="Filtrar marcas..." style="width: 200px;">
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>NOMBRE</th>
                <th>PAÍS</th>
                <th>SITIO WEB</th>
                <th class="text-end">EQUIPOS ASOCIADOS</th>
                <th class="text-end">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (marcas && marcas.length > 0) { %>
                <% marcas.forEach(m => { %>
                  <tr>
                    <td><strong class="text-body"><%= m.nombre %></strong></td>
                    <td><%= m.pais_origen || '-' %></td>
                    <td>
                      <% if (m.pagina_web) { %>
                        <a href="<%= m.pagina_web %>" target="_blank" rel="noopener" class="text-decoration-none">
                          <i class="bi bi-box-arrow-up-right me-1"></i>Web Oficial
                        </a>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td class="text-end font-tabular">
                      <span class="badge text-bg-success"><%= m.total_equipos || 0 %> equipos</span>
                    </td>
                    <td class="text-end">
                      <a href="/maestros/marcas/eliminar/<%= m.id_marca %>" class="btn btn-outline-danger btn-sm" title="Desactivar" onclick="return confirm('¿Desactivar marca <%= m.nombre %>?');">
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">No hay marcas registradas.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Flotante de Registro de Marca -->
<div class="modal fade" id="modalNuevaMarca" tabindex="-1" aria-labelledby="modalNuevaMarcaLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title fw-bold" id="modalNuevaMarcaLabel">
          <i class="bi bi-bookmark-plus me-2"></i> Registrar Nueva Marca
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <form method="POST" action="/maestros/marcas">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-semibold">NOMBRE DE LA MARCA <span class="text-danger">*</span></label>
            <input type="text" name="nombre" class="form-control" placeholder="Ej: TP-LINK, MIKROTIK, HUAWEI, VSOL" required autofocus>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">PAÍS DE ORIGEN</label>
            <input type="text" name="pais_origen" class="form-control" placeholder="Ej: China, Letonia, EE.UU.">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">SITIO WEB OFICIAL</label>
            <input type="url" name="pagina_web" class="form-control" placeholder="https://www.marca.com">
          </div>
        </div>
        <div class="modal-footer bg-body-tertiary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-save me-1"></i> Guardar Marca
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
