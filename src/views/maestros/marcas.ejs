<%- include('../layouts/header', { title: 'Marcas', activeNav: 'marcas' }) %>

<div class="row g-3">
  <!-- Formulario (Box Estilo Mikrowisp / AdminLTE) -->
  <div class="col-12 col-xl-4">
    <div class="erp-box erp-box-teal">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-bookmark-plus text-success"></i> Registrar Marca
        </div>
      </div>
      <div class="erp-box-body">
        <form method="POST" action="/maestros/marcas">
          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">NOMBRE DE LA MARCA <span class="text-danger">*</span></label>
            <input type="text" name="nombre" class="erp-input-sm w-100" placeholder="Ej: TP-LINK, MIKROTIK, HUAWEI, VSOL" required>
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">PAÍS DE ORIGEN</label>
            <input type="text" name="pais_origen" class="erp-input-sm w-100" placeholder="Ej: China, Letonia, EE.UU.">
          </div>

          <div class="mb-3">
            <label class="form-label" style="font-size: 11.5px; font-weight: 700; color: #4B646F;">SITIO WEB OFICIAL</label>
            <input type="url" name="pagina_web" class="erp-input-sm w-100" placeholder="https://www.marca.com">
          </div>

          <button type="submit" class="btn-erp btn-erp-success w-100 py-2">
            <i class="bi bi-save me-1"></i> Guardar Marca
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Listado Estilo DataTables -->
  <div class="col-12 col-xl-8">
    <div class="erp-box erp-box-blue">
      <div class="erp-box-header">
        <div class="erp-box-title">
          <i class="bi bi-bookmark-star text-primary"></i> Marcas Registradas
        </div>
        <span class="badge-erp badge-erp-primary"><%= marcas.length %> Marcas</span>
      </div>
      <div class="erp-box-body">
        
        <!-- Barra de Control Estilo DataTables -->
        <div class="datatables-header-bar">
          <div class="datatables-length-select">
            <span>Mostrar <strong>10</strong> registros por página</span>
          </div>
          <div class="datatables-search-filter">
            <label>Buscar:</label>
            <input type="text" id="quickTableSearch" class="erp-input-sm" placeholder="Filtrar marcas..." style="width: 180px;">
          </div>
        </div>

        <div class="table-responsive-erp">
          <table class="table-erp">
            <thead>
              <tr>
                <th>NOMBRE</th>
                <th>PAÍS</th>
                <th>SITIO WEB</th>
                <th class="col-number">EQUIPOS ASOCIADOS</th>
                <th class="actions-cell">ACCIONES</th>
              </tr>
            </thead>
            <tbody>
              <% if (marcas && marcas.length > 0) { %>
                <% marcas.forEach(m => { %>
                  <tr>
                    <td><strong><%= m.nombre %></strong></td>
                    <td><%= m.pais_origen || '-' %></td>
                    <td>
                      <% if (m.pagina_web) { %>
                        <a href="<%= m.pagina_web %>" target="_blank" rel="noopener" class="text-primary text-decoration-none">
                          <i class="bi bi-box-arrow-up-right me-1"></i>Web Oficial
                        </a>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td class="col-number">
                      <span class="badge-erp badge-erp-success"><%= m.total_equipos || 0 %> equipos</span>
                    </td>
                    <td class="actions-cell">
                      <a href="/maestros/marcas/eliminar/<%= m.id_marca %>" class="btn-erp btn-erp-danger btn-sm" title="Desactivar" onclick="return confirm('¿Desactivar marca <%= m.nombre %>?');">
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">No hay marcas registradas.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
